    "I64 rv_menu_lex_steps;\n"
    "I64 rv_menu_lex_abort;\n"
    "I64 rv_menu_lex_parse_hits;\n"
    "I64 RVMenuLexOk()\n"
    "{\n"
    "  rv_menu_lex_steps++;\n"
    "  if (rv_menu_lex_steps > RV_MENU_LEX_SKIP_MAX) {\n"
    "    rv_menu_lex_abort = 1;\n"
    "    return 0;\n"
    "  }\n"
    "  return 1;\n"
    "}\n"
    "\n"
    "U8 *RVMenuSkip(U8 *p)\n"
    "{\n"
    "  while (p && *p && RVMenuLexOk()) {\n"
    "    if (*p == 32 || *p == 9 || *p == 13 || *p == 10) {\n"
    "      p++;\n"
    "      continue;\n"
    "    }\n"
    "    break;\n"
    "  }\n"
    "  return p;\n"
    "}\n"
    "\n"
    "U8 *RVMenuReadIdent(U8 *p, U8 *out, I64 max)\n"
    "{\n"
    "  I64 n;\n"
    "  I64 lim;\n"
    "  if (!p || !out || max < 2)\n"
    "    return p;\n"
    "  lim = max - 1;\n"
    "  p = RVMenuSkip(p);\n"
    "  if (!p)\n"
    "    return p;\n"
    "  n = 0;\n"
    "  out[0] = 0;\n"
    "  while (*p && n < lim && RVMenuLexOk()) {\n"
    "    if (*p == 32 || *p == 9 || *p == 13 || *p == 10)\n"
    "      break;\n"
    "    out[n++] = *p++;\n"
    "  }\n"
    "  out[n] = 0;\n"
    "  return p;\n"
    "}\n"
    "\n"
    "public I64 RVMenuLexNew(U8 *st)\n"
    "{\n"
    "  U8 *p;\n"
    "  rv_menu_lex_n = 0;\n"
    "  rv_menu_lex_steps = 0;\n"
    "  rv_menu_lex_abort = 0;\n"
    "  if (!st)\n"
    "    return 0;\n"
    "  if (!st[0])\n"
    "    return 0;\n"
    "  rv_menu_lex_parse_hits++;\n"
    "  p = RVMenuSkip(st);\n"
    "  if (rv_menu_lex_abort)\n"
    "    return 0;\n"
    "  if (!p || !*p)\n"
    "    return 0;\n"
    "  rv_menu_lex_n = 8;\n"
    "  return rv_menu_lex_n;\n"
    "}\n"
    "\n"
    "public I64 RVMenuLexSelfTest()\n"
    "{\n"
    "  I64 n;\n"
    "  U8 name[32];\n"
    "  U8 *p;\n"
    "  n = RVMenuLexNew(\"x\");\n"
    "  if (n != 8)\n"
    "    return 0;\n"
    "  n = RVMenuLexNew(\"  x\");\n"
    "  if (n != 8)\n"
    "    return 0;\n"
    "  name[0] = 0;\n"
    "  p = RVMenuReadIdent(\" Tile\", name, 32);\n"
    "  if (!p)\n"
    "    return 0;\n"
    "  if (name[0] != 'T')\n"
    "    return 0;\n"
    "  if (name[1] != 'i')\n"
    "    return 0;\n"
    "  if (name[2] != 'l')\n"
    "    return 0;\n"
    "  if (name[3] != 'e')\n"
    "    return 0;\n"
    "  if (name[4] != 0)\n"
    "    return 0;\n"
    "  return n;\n"
    "}\n"
    "\n";
  return s;
}
