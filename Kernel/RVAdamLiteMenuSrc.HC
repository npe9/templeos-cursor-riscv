U8 *RVAdamLiteMenuLexSrc()
{
  U8 *s;
  s =
    "// Menu_RV_Guest_Lex.HC — index hand Lex → flat Personal ids"
    " (P6).\n"
    "// Folded into guest Menu wrap before Guest (see Menu_RV wra"
    "p + MENU_RV_GUEST_LEX_HC).\n"
    "// Flat Guest alone still Cmps without this file. Uses st[i]"
    " + local U8 name[] —\n"
    "// no local U8* lit walk, no CMenu heap (those still block g"
    "uest product Menu).\n"
    "#ifndef MENU_RV_GUEST_LEX_HC\n"
    "#define MENU_RV_GUEST_LEX_HC\n"
    "#define RV_MENU_LEX_MAX_STEPS 2048\n"
    "#define RV_MENU_LEX_MAX 16\n"
    "I64 rv_menu_lex_n;\n"
    "I64 rv_menu_lex_id[RV_MENU_LEX_MAX];\n"
    "I64 rv_menu_lex_steps;\n"
    "I64 rv_menu_lex_abort;\n"
    "I64 rv_menu_lex_parse_hits;\n"
    "Bool RVMenuLexOk()\n"
    "{\n"
    "  rv_menu_lex_steps++;\n"
    "  if (rv_menu_lex_steps > RV_MENU_LEX_MAX_STEPS) {\n"
    "    rv_menu_lex_abort = 1;\n"
    "    return FALSE;\n"
    "  }\n"
    "  return TRUE;\n"
    "}\n"
    "\n"
    "I64 RVMenuSkipI(U8 *st, I64 i)\n"
    "{\n"
    "  U8 ch;\n"
    "  while (st && RVMenuLexOk()) {\n"
    "    ch = st[i];\n"
    "    if (!ch)\n"
    "      break;\n"
    "    if (ch == ' ' || ch == '\\t' || ch == '\\r' || ch == '\\"
    "n') {\n"
    "      i++;\n"
    "      continue;\n"
    "    }\n"
    "    break;\n"
    "  }\n"
    "  return i;\n"
    "}\n"
    "\n"
    "I64 RVMenuReadIdentI(U8 *st, I64 i, U8 *out, I64 max)\n"
    "{\n"
    "  I64 n = 0;\n"
    "  U8 ch;\n"
    "  i = RVMenuSkipI(st, i);\n"
    "  if (!out || max < 2) {\n"
    "    if (out && max > 0)\n"
    "      out[0] = 0;\n"
    "    return i;\n"
    "  }\n"
    "  out[0] = 0;\n"
    "  if (!st)\n"
    "    return i;\n"
    "  ch = st[i];\n"
    "  if (!((ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z')"
    " || ch == '_'))\n"
    "    return i;\n"
    "  while (st[i] && n < max - 1 && RVMenuLexOk()) {\n"
    "    ch = st[i];\n"
    "    if (!((ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z"
    "') || (ch >= '0' && ch <= '9') || ch == '_'))\n"
    "      break;\n"
    "    out[n++] = ch;\n"
    "    i++;\n"
    "  }\n"
    "  out[n] = 0;\n"
    "  return i;\n"
    "}\n"
    "\n"
    "I64 RVMenuReadI64I(U8 *st, I64 i, I64 *out)\n"
    "{\n"
    "  I64 v = 0;\n"
    "  U8 ch;\n"
    "  i = RVMenuSkipI(st, i);\n"
    "  if (!out)\n"
    "    return i;\n"
    "  *out = 0;\n"
    "  if (!st)\n"
    "    return i;\n"
    "  while (RVMenuLexOk()) {\n"
    "    ch = st[i];\n"
    "    if (ch < '0' || ch > '9')\n"
    "      break;\n"
    "    v = v * 10 + (ch - '0');\n"
    "    i++;\n"
    "  }\n"
    "  *out = v;\n"
    "  return i;\n"
    "}\n"
    "\n"
    "I64 RVMenuIdFromIdent(U8 *name)\n"
    "{\n"
    "  //Char-wise match — no StrCmp import (guest Cmp unresolved"
    ").\n"
    "  if (!name || !name[0])\n"
    "    return 0;\n"
    "  if (name[0] == 'T' && name[4] == 'H')\n"
    "    return 1;\n"
    "  if (name[0] == 'T' && name[4] == 'V')\n"
    "    return 2;\n"
    "  if (name[0] == 'W' && name[3] == 'M')\n"
    "    return 3;\n"
    "  if (name[0] == 'C' && name[1] == 'l')\n"
    "    return 4;\n"
    "  if (name[0] == 'A' && name[1] == 'b')\n"
    "    return 5;\n"
    "  if (name[0] == 'H' && name[1] == 'e')\n"
    "    return 6;\n"
    "  if (name[0] == 'F' && name[1] == 'o')\n"
    "    return 7;\n"
    "  if (name[0] == 'C' && name[1] == 't')\n"
    "    return 8;\n"
    "  return 0;\n"
    "}\n"
    "\n"
    "I64 RVMenuParseFlatI(U8 *st, I64 i)\n"
    "{\n"
    "  U8 name[32];\n"
    "  I64 arg1 = 0, id;\n"
    "  U8 ch;\n"
    "  while (st && st[i] && rv_menu_lex_n < RV_MENU_LEX_MAX && R"
    "VMenuLexOk()) {\n"
    "    i = RVMenuSkipI(st, i);\n"
    "    if (!st[i] || st[i] == '}')\n"
    "      break;\n"
    "    i = RVMenuReadIdentI(st, i, name, 32);\n"
    "    if (!name[0]) {\n"
    "      if (st[i])\n"
    "        i++;\n"
    "      continue;\n"
    "    }\n"
    "    i = RVMenuSkipI(st, i);\n"
    "    ch = st[i];\n"
    "    if (ch == '(') {\n"
    "      arg1 = 0;\n"
    "      i++;\n"
    "      i = RVMenuSkipI(st, i);\n"
    "      if (st[i] && st[i] != ',' && st[i] != ')')\n"
    "        i = RVMenuReadI64I(st, i, &arg1);\n"
    "      i = RVMenuSkipI(st, i);\n"
    "      if (st[i] == ',') {\n"
    "        i++;\n"
    "        i = RVMenuSkipI(st, i);\n"
    "        if (st[i] && st[i] != ',' && st[i] != ')')\n"
    "          i = RVMenuReadI64I(st, i, &arg1);\n"
    "      }\n"
    "      while (st[i] && st[i] != ')' && RVMenuLexOk())\n"
    "        i++;\n"
    "      if (st[i] == ')')\n"
    "        i++;\n"
    "      i = RVMenuSkipI(st, i);\n"
    "      if (st[i] == ';')\n"
    "        i++;\n"
    "      id = RVMenuIdFromIdent(name);\n"
    "      if (!id && arg1 > 0)\n"
    "        id = arg1;\n"
    "      rv_menu_lex_id[rv_menu_lex_n] = id;\n"
    "      rv_menu_lex_n++;\n"
    "    } else if (ch == '{') {\n"
    "      i++;\n"
    "      i = RVMenuParseFlatI(st, i);\n"
    "      i = RVMenuSkipI(st, i);\n"
    "      if (st[i] == '}')\n"
    "        i++;\n"
    "    } else {\n"
    "      if (st[i])\n"
    "        i++;\n"
    "    }\n"
    "  }\n"
    "  return i;\n"
    "}\n"
    "\n"
    "public I64 RVMenuLexNew(U8 *st)\n"
    "{\n"
    "  rv_menu_lex_steps = 0;\n"
    "  rv_menu_lex_abort = 0;\n"
    "  rv_menu_lex_n = 0;\n"
    "  if (!st || !st[0])\n"
    "    return 0;\n"
    "  rv_menu_lex_parse_hits++;\n"
    "  RVMenuParseFlatI(st, 0);\n"
    "  if (rv_menu_lex_abort)\n"
    "    return 0;\n"
    "  return rv_menu_lex_n;\n"
    "}\n"
    "#endif\n"
    "\n";
  return s;
}
