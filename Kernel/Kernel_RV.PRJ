// RISC-V project list: Kernel.PRJ minus the x86 boot/interrupt/segment files (rewritten in phase 2).
// Used by `make coverage` to measure how much of the kernel the compiler accepts. Keep in sync.
//Compile this by calling $LK,"BootHDIns",A="MN:BootHDIns"$().
//Don't do it directly.  See $LK,"Cmp(\"/Kernel/Kernel\")",A="FF:::/Adam/Opt/Boot/BootHDIns.HC,Cmp(\"/Kernel/Kernel\""$.

#exe {
  Cd(__DIR__);;
  Option(OPTf_WARN_PAREN,ON);
  Option(OPTf_WARN_DUP_TYPES,ON);
  #include "KCfg"
  CKCfg *kernel_cfg;
  kernel_cfg=KCfgNew;
};
// Platform Kconfig → templeos-riscv/.config → RVAutoConf.HH (UART/CLINT/PLIC/virtio/FB/entry).
// Regenerate: make -C templeos-riscv defconfig | menuconfig. Default is QEMU virt (CI).
#include "RVAutoConf.HH"
// SYS_FIXED_AREA is an x86 fixed physical address (0x100000) that is unmapped on RISC-V; TaskInit
// reads the initial FPU state out of it, so on the QEMU virt machine it must name real RAM. Default
// it to a high RAM page here (guarded, so a program may still override it before the include). RVKMain
// zeroes that page at boot. See Kernel/KernelA.HH where the x86 default lives behind the same #ifndef.
#ifndef SYS_FIXED_AREA
#define SYS_FIXED_AREA CONFIG_SYS_FIXED_AREA
#endif
// RISCV_VIRT is set by RVAutoConf on PLATFORM_VIRT (Goldfish RTC path in KDate, etc.).
#include "KernelA.HH"
#include "KStartRV"   // RISC-V stand-in for KStart16/32/64, KInts, MultiProc, FunSeg (needs KernelA.HH types)
#include "KMathA"
#include "KUtils"
#exe {Option(OPTf_KEEP_PRIVATE,ON);};
#include "/Compiler/CompilerA.HH"
#exe {Option(OPTf_EXTERNS_TO_IMPORTS,ON);};
#include "/Compiler/CompilerB.HH"
#exe {Option(OPTf_EXTERNS_TO_IMPORTS,OFF);};
#exe {Option(OPTf_KEEP_PRIVATE,OFF);};
#include "KernelB.HH"
#include "KExts"
