#endif
#include "KBootRV"   // RISC-V portable boot init (tables + UART console)
#ifndef RV_THIN_LOADER
#include "Drv/RVFwCfg.HC" // QEMU fw_cfg DMA / file dir (before RVFb ramfb)
#include "RVFb"      // Native 32-bpp linear FB + ramfb/simplefb present (not VGA)
#include "Drv/RVFbPlat.HC"     // apply Kconfig FB present kind → RVFbSetPresent
#include "Drv/RVMemMap.HC"     // MMIO region ↔ driver legend (Kconfig)
#include "RVGr"      // Thin Gr*/CDC + soft term + RVSysGrInit (32-bpp; not full Adam)
#include "RVSprite"  // Sprite3/DC2Sprite subset on CRVDC (Demo blot/SpriteRaw; not mesh)
#include "RVODE"     // demoted — stock Demo/Games/MassSpring.HC is the product path
#include "RVDoc"     // P2 minimal CDoc entry stream (HOME Recalc/PutKey/links)
#include "/Adam/DolDoc/MakeDoc_RV" // P2 shim → RVDocDemoProbe (full MakeDoc deferred G8)
#include "/Adam/Menu_RV"   // MenuNew-lite + PersonalMenu.DD text (P3; no WinMgr deps)
#include "RVWinMgr"  // TempleOS-style text_base WinMgr → rv_fb present (no VGA/DolDoc)
#include "RVAC"      // AutoComplete lite (after WinMgr: FillIn → RVWinBodyPutChar)
#include "/Adam/PopUp_RV"  // PopUpOk/NoYes + DocForm-lite modal on FB (P3; needs RVWin*)
#include "/Adam/Ctrls_RV"  // Bttn/Slider subset on CRVDC (P3; needs RVWin* + Gr*)
#include "/Adam/WinDemo_RV" // Soft SettingsPush/WinMax/PopUpColor/Refresh for Demo/*.HC
#include "/Adam/ASnd_RV"    // Soft music/Play/SndTaskEndCB for Apps SongTask (Span)
#include "/Adam/ABlkDev/FileMgr_RV" // FMRebuildDocDrv + soft shims; RVFileMgrOpen in RVWinMgr
#include "RVWinSerial" // UART TTY + crash mon beside WinMgr (after rv_winmgr glbls)
#include "RVFsJournal" // FsChanges/FsLog/FsReplay/DumpChanges/Recover — needs FileRead/Find/Del
#include "RVExplore"   // AsmList/AsmDoc/MemMap/Mstatus/Mcause — RISC-V exploration (needs RVWinCsrr*)
#include "RVDisasm"   // Disasm/U/UA/DisasmAt — seed disasm.hc port over the task hash
#include "RVTextBase" // TextChar/TextPrint portable (DocRecalc / draw_it)
#include "RVRegistry" // in-memory RegDft/RegExe/RegWrite (the compile-time half is in host/parser.c)
#include "/Adam/CPURep.HC" // stock CPURep() — 6 demos name it (docs/DEMO_SURVEY.md)
// DocFind + DocLink for the LK_* link kinds (LK_FILE_LINE, LK_PLAIN_LINE) and EdLinkCvt.
// BIBLE_FILENAME is DocLink's only other need; stock defines it in Adam/DolDoc/MakeDoc.HC, which
// this port replaces with MakeDoc_RV, so it is named here at its stock value. That makes DocLink
// COMPILE; DocLink:244 opens it, so on a driveless image that path still throws('Drv').
#ifndef BIBLE_FILENAME
#define BIBLE_FILENAME "::/Misc/Bible.TXT.Z"
#endif
// DocChar + DocRun BEFORE DocFind/DocLink, which call into them. Without these two units the
// calls became unresolved imports and bootstrap/holy_rt.h wrote a stub that returns 0 into each
// slot — silently, since nothing provides those names. EdCurU8 was the damaging one: it is an
// ACCESSOR, returning the character under the cursor, so a 0 makes every EdCurU8(doc)==':' in
// DocFind false and abort_on_dbl_colon — DolDoc's Func:: dig-down — can never fire.
// tools/check_prj_collisions.py says neither unit collides with anything here; the three other
// units that define the remaining MISSING names (DocRecalc, DocNew, DocRecalcLib) all do.
// tests/portability_seam.tsv records the four names this closes.
#include "/Adam/DolDoc/DocChar.HC"  // EdCurU8, EdCursorLeft, EdCursorRight
#include "/Adam/DolDoc/DocRun.HC"   // DocEntryRun
#include "/Adam/DolDoc/DocFind.HC"
#include "/Adam/DolDoc/DocLink.HC"
// Sort() and LongLines() — the two cmd-line string utilities Demo/AcctExample/TOS/TOSIns.HC and
// TOSDistro.HC name. AFTER the DolDoc block above because every call in it lands there or earlier:
// DocRead/DocWrite/DocPrint/DocNew/DocDel/DocEntryDel (RVDoc + DocChar), QSort (QSort.HC),
// FilesFind/DirTreeDel (BlkDev/MakeBlkDev), Define (KDefine), MStrUtil/ExtDft (StrA/StrB) and
// char_bmp_alpha (KGlbls). Measured with tools/blob_imports.py: adding it leaves exactly ONE new
// unresolved name, DocInsDoc — U0, so its stub returning 0 cannot trap or poison a value, and the
// only call to it in this unit is the last line of Words(), which neither demo reaches.
// (DocInsDoc's body is in Adam/DolDoc/DocFile.HC, which is not in the closure.)
#include "/Adam/Opt/Utils/StrUtils.HC"
// Adam graphics tables the demos name: gr_x_offsets/gr_y_offsets (the 8 neighbours, GrPeek loops),
// gr_rainbow_10 and gr_palette_gray. GrMath also brings Mat4x4* — the fixed-point transform — which
// needed GR_SCALE, whose value ::/Doc/Transform.DD states rather than leaving to guesswork.
#include "/Adam/Gr/GrMath.HC"
#include "/Adam/Gr/GrPalette.HC"
// InSetMs(), which Demo/InFile/InSetIP.HC names and which is its ONLY error. Adam/InFile.HC cannot
// be added whole: its InView() is `Bool res=View;` and `View` has no body anywhere in this tree
// (the only occurrence is an extern in Adam/AExts.HC), so the unit does not compile —
//   /Adam/InFile.HC:110:17: error: Undefined variable 'View'
// InFile_RV.HC lifts the two functions and two globals verbatim instead. It has to come AFTER
// GrMath.HC on the line above, because that is where Line() — the fixed-point stepper InSetMs
// drives the mouse with — actually lives. Zero new unresolved names (tools/blob_imports.py).
#include "/Adam/InFile_RV.HC"
// NOT added, although each compiles clean: DocDblBuf, DocRecalcLib, ARegistry and ASnd each define
// a function this image already defines, and a second body for one name wins silently. Check with
// tools/check_prj_collisions.py before adding an Adam unit.
//   DocDblBuf    DocBorder/DocDisplay (RVWinMgr), DocPut (RVSprite)
//   DocRecalcLib DocClear/DocCursor/DocTop/DocBottom/DocScroll/DocCenter (RVDoc)
//   ARegistry    RegDft/RegExe/RegWrite (RVRegistry)
//   ASnd         Play/Beat/MusicSet*/Note2Ona/SndTaskEndCB/tM (ASnd_RV)
#include "RVPhase3.HH"  // phase-3 forward decls (bodies after Compiler_RV_Body in phase3 demo)
#endif
#ifdef RV_THIN_LOADER
#include "RVThinLoader.HC" // body before RVKMain — avoid HOFY __imp_RVThinLoader=0
#else
#include "RVThinLoader.HH" // G9 thin-loader handoff decls (body in thin-loader demo)
#endif
#include "RVKMain"   // RVKMain last — may call RVSysGrInit / RVSysWinInit
#exe {KCfgDel(kernel_cfg);};
