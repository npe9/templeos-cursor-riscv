//x86: #include "FunSeg"
#include "KMain"
#include "KUtilsRV"   // native RISC-V ports of KUtils.HC low-level primitives (MemSet/MemCpy)
#include "KMathA_RV"  // HolyC D3* (KMathA x86 FPU asm skipped)
#include "/Adam/AMathODE_RV" // ODENew/RK5 + ODEsUpdate (soft winmgr timing)
#include "KCmpStubsRV" // HashAddAfter/CallExt*/Doc* stubs for Compiler_RV ExePutS
#include "Drv/RVSifivePlat.HC" // SiFive UART/CLINT/PLIC facade (Yes on sifive_u/e)
