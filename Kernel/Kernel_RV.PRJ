#include "KHashB"
#include "KLoad" // SoftCall KLoadSoft packs LoadPass1 import+ABS into Kernel.BIN (→'LD')
#include "RVHofyPatch" // HOFYIMP1 re-patch from Fs after Load(Compiler.BIN)
