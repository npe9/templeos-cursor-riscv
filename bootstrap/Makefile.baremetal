# Bare-metal RAM artifacts for FPGA OpenOCD and QEMU -bios none -kernel.
#
# Outputs (repo-root build/baremetal/):
#   plat.elf / plat.bin   — kernel plat demo (default PAYLOAD=plat MACHINE=virt)
#   For HolyC REPL RAM image use repo-root: make repl-payload → build/baremetal/repl.bin
#
# Plat images are copied into a stable install dir with a flat .bin for OpenOCD /
# QEMU -kernel. Legacy C guest (worry_dream) PAYLOAD=repl removed.
#
# Flash packaging (FPGA BRAM/flash boot @ FLASH_BASE) stays on make firmware — see
# bootstrap/Makefile.firmware and docs/BAREMETAL.md.

RISCV_PREFIX = riscv64-unknown-elf-
OBJCOPY = $(RISCV_PREFIX)objcopy

ROOT     := ..
BMD_DIR  := $(ROOT)/build/baremetal
KCFG     := $(ROOT)/templeos-riscv/include/generated/kconfig.mk

# Optional Kconfig bases (ENTRY_POINT / LOAD_BASE / MARCH from syncconfig).
ifneq ($(wildcard $(KCFG)),)
  include $(KCFG)
endif

ifeq ($(origin LOAD_BASE),undefined)
  ifneq ($(ENTRY_POINT),)
    LOAD_BASE := $(ENTRY_POINT)
  else ifneq ($(RAM_BASE),)
    LOAD_BASE := $(RAM_BASE)
  else
    LOAD_BASE := 0x80000000
  endif
endif
ifeq ($(LOAD_BASE),)
  LOAD_BASE := 0x80000000
endif

PAYLOAD  ?= plat
MACHINE  ?= virt

ifeq ($(PAYLOAD),repl)
  $(error Legacy C guest baremetal PAYLOAD=repl removed (worry_dream deleted). Use: make repl-payload / make bootloader-repl, or PAYLOAD=plat)
else ifeq ($(PAYLOAD),plat)
  SRC_ELF   := $(ROOT)/build/kernels/$(MACHINE)/plat.elf
  OUT_STEM  := plat
  BUILD_CMD := $(ROOT)/tests/scripts/build_kernel_plat.sh $(MACHINE)
else
  $(error Set PAYLOAD=plat (legacy PAYLOAD=repl / worry_dream removed; use make repl-payload))
endif

OUT_ELF := $(BMD_DIR)/$(OUT_STEM).elf
OUT_BIN := $(BMD_DIR)/$(OUT_STEM).bin

.PHONY: all baremetal clean qemu-args

all baremetal: $(OUT_BIN) $(OUT_ELF)
	@echo "✓ Bare-metal RAM @ $(LOAD_BASE):"
	@echo "  ELF: $(OUT_ELF)  (OpenOCD/gdb, qemu -kernel)"
	@echo "  BIN: $(OUT_BIN)  (OpenOCD binary load, qemu -kernel)"
	@echo "  QEMU: $(QEMU_ARGS)"

$(BMD_DIR):
	@mkdir -p $@

$(SRC_ELF):
	@$(BUILD_CMD)

$(OUT_ELF): $(SRC_ELF) | $(BMD_DIR)
	cp $< $@

$(OUT_BIN): $(OUT_ELF)
	$(OBJCOPY) -O binary $< $@

QEMU ?= qemu-system-riscv64
QEMU_ARGS = $(QEMU) -M virt -m 128M -bios none -kernel $(OUT_BIN) -nographic

qemu-args:
	@echo "$(QEMU_ARGS)"

clean:
	rm -f $(BMD_DIR)/repl.elf $(BMD_DIR)/repl.bin \
	      $(BMD_DIR)/plat.elf $(BMD_DIR)/plat.bin
