# Seed blob headers for the HolyC REPL.
#
# This makefile used to build the legacy C guest `repl.elf` from worry_dream_repl.c. That
# guest was deleted in 080f729, and with it the whole cross-compile setup that lived here:
# RISCV_PREFIX/CC/LD, the PLATFORM address-map rows (qemu-virt LOAD_BASE/UART_BASE), MARCH /
# MABI, and CFLAGS. Nothing left in this file compiles or links, so that block is gone rather
# than kept as dead configuration that looks like it still selects a board.
#
# Board selection for product images is Kconfig now:
#   make menuconfig  /  make -C templeos-riscv defconfig-<board>
# Guest images:
#   make hc-repl        -> build/repl-holyc.elf   (classic UART HolyC REPL)
#   make repl-payload   -> build/hc_repl.blob.bin (flat payload for the HolyC bootloader)

# Default goal is the blob headers. It used to fall through to repl.elf, so a plain
# `make -f Makefile.repl` did nothing but print an error.
.DEFAULT_GOAL := blobs

blobs: boot_blob_embed.h
	@echo "seed boot blob up to date (boot_blob_embed.h)"
	@echo "guest image: run 'make hc-repl' (or 'make repl-payload') from the repo root" >&2

repl.elf:
	@echo "error: legacy C guest repl.elf removed (worry_dream deleted); use: make hc-repl or make repl-payload" >&2
	@exit 2

# C table for the deleted guest's memfs_seed(). Nothing #includes seed_files.h today
# (the HolyC image seeds from boot_blob_embed.h / hc_repl/gen_embed.py), so it is NOT part
# of `blobs`; build it explicitly if you are reviving that path. Unlike the other
# generators this one walks all of seed/, so it fails on any file missing from
# seed_layout.py FILE_DIR.
seed_files.h: $(wildcard seed/*.hc) $(wildcard seed/tutorials/*.hc) \
		$(wildcard seed/datasheet/*.hc) gen_seeds.py seed_layout.py
	python3 gen_seeds.py seed seed_files.h

# Prebuilt boot runtime snapshot (concatenated seeds). Rebuild after editing seeds:
#   make -C bootstrap -f Makefile.repl boot_blob_embed.h
# or from repo root: make repl-blob
# Validates with host holyc-riscv AOT when ../holyc-riscv exists.
HOLYC_HOST ?= ../holyc-riscv
boot_blob_embed.h: $(wildcard seed/*.hc) gen_boot_blob.py
	@if [ -x "$(HOLYC_HOST)" ]; then \
	  python3 gen_boot_blob.py seed $@ $(HOLYC_HOST) boot_runtime.bin; \
	else \
	  python3 gen_boot_blob.py seed $@; \
	fi

# Tab-completion templates for the deleted C guest's readline. Nothing #includes this
# today (the HolyC readline reads seed/asm_complete.hc), so it is NOT part of `blobs`;
# build it explicitly if you are reviving that path.
asm_templates.inc: seed/asm_doc.hc gen_boot_blob.py
	python3 gen_boot_blob.py seed boot_blob_embed.h

clean:
	rm -f *.o *.elf seed_files.h boot_blob_embed.h boot_runtime.hc boot_runtime.bin

.PHONY: clean blobs
