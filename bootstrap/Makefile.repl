RISCV_PREFIX = riscv64-unknown-elf-
CC = $(RISCV_PREFIX)gcc
LD = $(RISCV_PREFIX)ld

# Host HolyC→RISC-V compiler sources (repo host/)
HOST = ../host
# Repo root on -I path so host/compiler.c can #include "bootstrap/holy_rt_names.h"
ROOT = ..

# ---- Platform address map -----------------------------------------------------------------
# Select a target board with PLATFORM=<name> (default: qemu-virt). Each row sets the RAM/link
# base and the 16550 UART base; LOAD_BASE flows to the linker (--defsym) and UART_BASE to both
# the C REPL (-DUART_BASE) and the linker. To retarget, add a row -- nothing else is platform-
# specific: startup.s uses only linker symbols and every other MMIO address (CLINT/PLIC/virtio)
# is the RISC-V-standard layout QEMU virt and most SoCs share.
#
# NOTE: `-bios none` makes QEMU's reset ROM jump to 0x80000000 unconditionally, so a non-default
# LOAD_BASE build links correctly but is NOT bootable via `-kernel` on qemu-virt -- it targets a
# board whose loader jumps to that base. Verify such builds with objdump, not QEMU.
PLATFORM ?= qemu-virt

ifeq ($(PLATFORM),qemu-virt)
  PLAT_LOAD_BASE := 0x80000000
  PLAT_UART_BASE := 0x10000000
# ---- template: copy this block, rename, and set the board's addresses --------------------
# else ifeq ($(PLATFORM),my-board)
#   PLAT_LOAD_BASE := 0x........
#   PLAT_UART_BASE := 0x........
else
  $(error Unknown PLATFORM '$(PLATFORM)' -- add a row to Makefile.repl, or pass LOAD_BASE=/UART_BASE= directly)
endif

# A direct LOAD_BASE=/UART_BASE= on the command line overrides the platform row.
LOAD_BASE ?= $(PLAT_LOAD_BASE)
UART_BASE ?= $(PLAT_UART_BASE)

CFLAGS = -march=rv64imafdc_zifencei -mabi=lp64d -mcmodel=medany -O0 -g
CFLAGS += -nostdlib -ffreestanding -fno-builtin -I$(ROOT) -I$(HOST) -DUART_BASE=$(UART_BASE)

LDFLAGS = -T linker.ld -nostdlib --no-warn-mismatch \
          --defsym LOAD_BASE=$(LOAD_BASE)

# DEPRECATED guest path: still C-dependent (worry_dream_repl.c + holy_rt + 0x87001xxx host
# slots). Prefer make hc-repl (no guest C) or kernel+Compiler_RV. Remaining C deps in seeds:
#   compile/run, UART ring+drain+get, Ed/Edit repair, Fmt, srcmap/hash/call_editor,
#   Callers*/MemMap/Regs/StkRep, trap dispatch/reentry.
# HolyC-owned: Term geometry + TermKeyGet (interactive), memfs arena at 0x85000000 (seed/fs.hc).
# C memfs/Term* slots remain as deprecated bridges for EdC/EditC/seed boot only.
repl.elf: startup.o worry_dream_repl.o compiler.o
	$(LD) $(LDFLAGS) -o $@ $^
	@echo "✓ Built Worry Dream REPL (DEPRECATED: C guest + host slots — see comment above)"

compiler.o: $(HOST)/compiler.c $(HOST)/lexer.c $(HOST)/parser.c $(HOST)/hash_table.c \
		$(HOST)/compiler_helper.c $(HOST)/holyc_fmt.c $(HOST)/holyc_compiler.h \
		$(HOST)/hash_table.h $(HOST)/holyc_fmt.h holy_rt.h holy_rt_names.h
	$(CC) $(CFLAGS) -DBARE_METAL -c $(HOST)/compiler.c -o compiler_main.o
	$(CC) $(CFLAGS) -DBARE_METAL -c $(HOST)/lexer.c -o lexer.o
	$(CC) $(CFLAGS) -DBARE_METAL -c $(HOST)/parser.c -o parser.o
	$(CC) $(CFLAGS) -DBARE_METAL -c $(HOST)/hash_table.c -o hash.o
	$(CC) $(CFLAGS) -DBARE_METAL -c $(HOST)/compiler_helper.c -o compiler_helper.o
	$(CC) $(CFLAGS) -DBARE_METAL -c $(HOST)/holyc_fmt.c -o holyc_fmt.o
	$(LD) -r -o $@ compiler_main.o lexer.o parser.o hash.o compiler_helper.o holyc_fmt.o

# The editable HolyC primitives/editors are real files under seed/; this bakes them into a C
# table so memfs_seed() ships them. Editing a seed/*.hc regenerates the header and rebuilds.
seed_files.h: $(wildcard seed/*.hc) gen_seeds.py
	python3 gen_seeds.py seed seed_files.h

# Prebuilt boot runtime snapshot (concatenated seeds). Rebuild after editing seeds:
#   make -C bootstrap -f Makefile.repl boot_blob_embed.h
# or from repo root: make repl-blob
# Validates with host holyc-riscv AOT when ../holyc-riscv exists.
HOLYC_HOST ?= ../holyc-riscv
boot_blob_embed.h: $(wildcard seed/*.hc) gen_boot_blob.py
	@if [ -x "$(HOLYC_HOST)" ]; then \
	  python3 gen_boot_blob.py seed $@ $(HOLYC_HOST) boot_runtime.bin; \
	else \
	  python3 gen_boot_blob.py seed $@; \
	fi

worry_dream_repl.o: worry_dream_repl.c $(HOST)/holyc_compiler.h $(HOST)/hash_table.h \
		holy_rt.h holy_rt_names.h seed_files.h boot_blob_embed.h
	$(CC) $(CFLAGS) -c $< -o $@

startup.o: startup.s
	$(CC) $(CFLAGS) -c $< -o $@

run: repl.elf
	qemu-system-riscv64 -M virt -bios none -kernel repl.elf -nographic

clean:
	rm -f *.o *.elf seed_files.h boot_blob_embed.h boot_runtime.hc boot_runtime.bin

.PHONY: run clean
