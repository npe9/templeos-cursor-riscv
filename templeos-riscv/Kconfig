#
# TempleOS/RISC-V — platform / QEMU machine configuration
#
# Usage (from repo root):
#   make menuconfig
#   make -C templeos-riscv defconfig              # virt (default)
#   make -C templeos-riscv defconfig-sifive_u
#
# Generates: .config, include/generated/autoconf.h, ../Kernel/RVAutoConf.HH
#

mainmenu "TempleOS/RISC-V Platform Configuration"

source "Kconfig.machines"

menu "Architecture / toolchain"

choice
	prompt "RISC-V ISA (-march)"
	default ISA_RV64IMAFDC
	help
	  GCC/Clang -march string for bootstrap C, harness asm, and kconfig.mk.
	  HolyC AOT remains RV64 until the RV32 port lands (see RV32.md).
	  Selecting rv32* sets ARCH_RISCV32 for headers / qemu-system choice only.

config ISA_RV64IMAFDC
	bool "rv64imafdc (default — CI / FPU)"
	help
	  Full RV64GC-class string used by CI smokes (lp64d).

config ISA_RV64IMAC
	bool "rv64imac"
	help
	  RV64IMAC without F/D — integer + compressed (lp64).

config ISA_RV64IMA
	bool "rv64ima"
	help
	  RV64IMA without C (lp64). Matches many gas oracle baselines.

config ISA_RV64I
	bool "rv64i (minimal)"
	help
	  Base RV64I only (lp64). Experimental for tiny bring-up.

config ISA_RV32IMAFDC
	bool "rv32imafdc (experimental — see RV32.md)"
	help
	  RV32GC-class. Headers/QEMU binary track ARCH_RISCV32; HolyC emit is
	  still RV64 until the RV32 port (RV32.md).

config ISA_RV32IMA
	bool "rv32ima (experimental — see RV32.md)"
	help
	  RV32IMA (ilp32). Same caveats as rv32imafdc.

config ISA_CUSTOM
	bool "Custom (edit RISCV_ISA string below)"
	help
	  Set RISCV_ISA / RISCV_ABI manually (e.g. with _zicsr_zifencei).

endchoice

config RISCV_ISA
	string "Custom -march string" if ISA_CUSTOM
	default "rv64imafdc" if ISA_RV64IMAFDC
	default "rv64imac" if ISA_RV64IMAC
	default "rv64ima" if ISA_RV64IMA
	default "rv64i" if ISA_RV64I
	default "rv32imafdc" if ISA_RV32IMAFDC
	default "rv32ima" if ISA_RV32IMA
	default "rv64imafdc"
	help
	  Emitted as MARCH / CONFIG_RISCV_ISA. With ISA_CUSTOM, type the full
	  -march value here.

config RISCV_ABI
	string "Custom -mabi string" if ISA_CUSTOM
	default "lp64d" if ISA_RV64IMAFDC
	default "lp64" if ISA_RV64IMAC
	default "lp64" if ISA_RV64IMA
	default "lp64" if ISA_RV64I
	default "ilp32d" if ISA_RV32IMAFDC
	default "ilp32" if ISA_RV32IMA
	default "lp64d"
	help
	  Emitted as MABI / CONFIG_RISCV_ABI.

config ARCH_RISCV32
	bool
	default y if ISA_RV32IMAFDC || ISA_RV32IMA
	default n

config ARCH_RISCV64
	bool
	default y if !ARCH_RISCV32

config ENTRY_POINT
	hex "Entry point (boot/link address)"
	default 0x20400000 if PLATFORM_SIFIVE_E
	default 0x20000400 if PLATFORM_OPENTITAN
	default 0x40200000 if PLATFORM_VISIONFIVE2 || PLATFORM_MILKV_MARS
	default 0x80000000
	help
	  Physical address where the image is linked / reset jumps for plat load.
	  virt-like boards: DRAM @ 0x80000000. sifive_e: XIP flash @ 0x20400000
	  (DTIM @ 0x80000000 is only 16 KiB). OpenTitan: flash boot @ 0x20000400
	  (SRAM @ 0x10000000). VisionFive 2: DDR @ 0x40000000; OpenSBI/U-Boot
	  typically reserve 0x40000000–0x40200000 — link at 0x40200000.
	  Feeds kconfig.mk ENTRY_POINT / LOAD_BASE / RAM_BASE.

endmenu

menu "Memory map / link"

config DRAM_BASE
	hex "DRAM base (physical)"
	default 0x10000000 if PLATFORM_OPENTITAN
	default 0x40000000 if PLATFORM_VISIONFIVE2 || PLATFORM_MILKV_MARS
	default 0x80000000
	help
	  Physical base of main RAM. Most QEMU boards use 0x80000000;
	  OpenTitan uses 0x10000000 (128 KiB SRAM). VisionFive 2 / JH7110
	  DDR starts at 0x40000000 (2/4/8 GiB SKUs).

config DRAM_SIZE
	hex "DRAM size (bytes)"
	default 0x00020000 if PLATFORM_OPENTITAN
	default 0x00004000 if PLATFORM_SIFIVE_E
	default 0x80000000 if PLATFORM_VISIONFIVE2 || PLATFORM_MILKV_MARS
	default 0x08000000
	help
	  Size of main RAM region for linker scripts (default 128 MiB for virt smokes;
	  sifive_e / opentitan are tiny — full images do not fit). VisionFive 2:
	  2 GiB (minimum SKU); larger boards still OK with this legend size.

config KERNEL_ENTRY
	hex "Kernel entry / -kernel load address"
	default ENTRY_POINT
	help
	  Address QEMU jumps to with -bios none -kernel. Defaults to ENTRY_POINT.
	  Must match linker ORIGIN unless you intentionally split entry vs VMA.

config KERNEL_LINK_ADDR
	hex "Kernel link / VMA base"
	default ENTRY_POINT
	help
	  Linker VMA for .text. Defaults to ENTRY_POINT (same as KERNEL_ENTRY
	  on typical bare metal).

config GUEST_BLOB_ADDR
	hex "HolyC guest blob VMA (templeos-riscv)"
	default 0x10010000 if PLATFORM_OPENTITAN
	default 0x40300000 if PLATFORM_VISIONFIVE2 || PLATFORM_MILKV_MARS
	default 0x80100000

config COMPILER_SLOT_ADDR
	hex "Compiler slot VMA"
	default 0x10018000 if PLATFORM_OPENTITAN
	default 0x40400000 if PLATFORM_VISIONFIVE2 || PLATFORM_MILKV_MARS
	default 0x80200000

config TOS_API_ADDR
	hex "TosApi VMA"
	default 0x1001C000 if PLATFORM_OPENTITAN
	default 0x40500000 if PLATFORM_VISIONFIVE2 || PLATFORM_MILKV_MARS
	default 0x80300000

config SYS_FIXED_AREA
	hex "SYS_FIXED_AREA (HolyC FPU save page)"
	default 0x1001F000 if PLATFORM_OPENTITAN
	default 0x47000000 if PLATFORM_VISIONFIVE2 || PLATFORM_MILKV_MARS
	default 0x87000000
	help
	  RISC-V stand-in for x86 SYS_FIXED_AREA; must be real RAM.

config FB_SOFT_BASE
	hex "Software framebuffer base (RVFb soft buffer)"
	default 0x1001E000 if PLATFORM_OPENTITAN
	default 0x46100000 if PLATFORM_VISIONFIVE2 || PLATFORM_MILKV_MARS
	default 0x86100000
	depends on FB_PRESENT_RAMFB || FB_PRESENT_SIMPLEFB || FB_PRESENT_NONE

config HEAP_BASE
	hex "HolyC soft heap base (REPL / seed MEM_HEAP)"
	default 0x1001A000 if PLATFORM_OPENTITAN
	default 0x46000000 if PLATFORM_VISIONFIVE2 || PLATFORM_MILKV_MARS
	default 0x86000000
	help
	  Soft heap arena used by REPL seed mem.hc. Must be inside DRAM.

config MEMFS_BASE
	hex "HolyC memfs arena base (seed MEM_FS)"
	default 0x1001B000 if PLATFORM_OPENTITAN
	default 0x47800000 if PLATFORM_VISIONFIVE2 || PLATFORM_MILKV_MARS
	default 0x87800000
	help
	  In-RAM memfs for FileRead/FileWrite. Needs DRAM large enough
	  (virt default 128 MiB reaches 0x87800000).

config HOST_SLOTS_BASE
	hex "Transitional REPL host-slots page (seed MEM_HOST_SLOTS)"
	default 0x47001000 if PLATFORM_VISIONFIVE2 || PLATFORM_MILKV_MARS
	default 0x87001000
	help
	  Fixed page for Mac-AOT REPL C↔HolyC ABI (compile/run funptrs,
	  UART ring metadata, trapvec, editors). This is NOT board MMIO —
	  it must stay stable for board/driver MMIO contracts. Board
	  ports that drop the transitional REPL can ignore it; Kernel OS
	  paths prefer CONFIG_* / Hash over slots.

config SMP_MAILBOX_BASE
	hex "Multi-hart SMP mailbox base (RVSmp / crt0_smp)"
	default 0x47001E00 if PLATFORM_VISIONFIVE2 || PLATFORM_MILKV_MARS
	default 0x87001E00
	help
	  Shared mailbox near SYS_FIXED_AREA: entry/arg/done/alive.
	  Must match tests/exec/harness/crt0_smp.S .equ values.

config STACK_BASE
	hex "Initial stack top hint (seed MEM_STACK)"
	default 0x1001F800 if PLATFORM_OPENTITAN
	default 0x47F00000 if PLATFORM_VISIONFIVE2 || PLATFORM_MILKV_MARS
	default 0x87F00000
	help
	  Documentation / MemMap legend for early stack; linker scripts
	  own the real stack symbol.

endmenu

menu "UART console"

choice
	prompt "UART driver"
	default UART_16550 if PLATFORM_VIRT
	default UART_16550 if PLATFORM_XIANGSHAN
	default UART_16550 if PLATFORM_MICROCHIP_ICICLE
	default UART_16550 if PLATFORM_VISIONFIVE2 || PLATFORM_MILKV_MARS
	default UART_SIFIVE if PLATFORM_SIFIVE_U
	default UART_SIFIVE if PLATFORM_SIFIVE_E
	default UART_HTIF if PLATFORM_SPIKE
	default UART_SHAKTI if PLATFORM_SHAKTI_C
	default UART_UARTLITE if PLATFORM_AMD_MICROBLAZE_V
	default UART_IBEX if PLATFORM_OPENTITAN
	default UART_STUB

config UART_16550
	bool "NS16550A (QEMU virt / best-guess)"
	help
	  Byte-wide 16550 at UART_BASE. virt: 0x10000000. Boards with regshift=2
	  (xiangshan, VisionFive 2 DW8250) TX-to-base still works for plat smoke;
	  RX may need spaced accesses. amd-microblaze 16550 is serial1 — prefer
	  UARTLite on serial0.

config UART_SIFIVE
	bool "SiFive UART0"
	help
	  Word-wide SiFive UART (sifive_u: 0x10010000, sifive_e: 0x10013000).

config UART_HTIF
	bool "Spike HTIF console (experimental)"
	help
	  Character I/O via Spike/QEMU HTIF. Experimental — not used by CI.

config UART_SHAKTI
	bool "Shakti UART"
	help
	  Shakti C-class UART (TX @ BASE+4, STATUS @ BASE+0xC). QEMU shakti_c
	  @ 0x11300. Load plat ELF as -bios (machine ignores -kernel).

config UART_UARTLITE
	bool "Xilinx UARTLite"
	help
	  XPS UARTLite TX @ BASE+4. QEMU amd-microblaze-v-generic serial0 @
	  0x40600000. That machine has no -kernel/-bios loader — use
	  -device loader,file=ELF,cpu-num=0.

config UART_IBEX
	bool "OpenTitan / lowRISC Ibex UART"
	help
	  Word regs: CTRL@+0x10 (TX_ENABLE), STATUS@+0x14 (TXFULL), WDATA@+0x1c.
	  QEMU opentitan @ 0x40000000. HolyC driver RVUartIbex; plat smoke today
	  uses an RV32 asm harness until ARCH_RISCV32 (RV32.md).

config UART_STUB
	bool "Stub (no console hardware)"
	help
	  Compiles; putc is a no-op. For boards without a known console yet.

endchoice

config UART_BASE
	hex "UART MMIO base"
	default 0x10000000 if UART_16550 && PLATFORM_VIRT
	default 0x310B0000 if UART_16550 && PLATFORM_XIANGSHAN
	default 0x20000000 if UART_16550 && PLATFORM_MICROCHIP_ICICLE
	default 0x10000000 if UART_16550 && (PLATFORM_VISIONFIVE2 || PLATFORM_MILKV_MARS)
	default 0x10000000 if UART_16550
	default 0x10010000 if UART_SIFIVE && PLATFORM_SIFIVE_U
	default 0x10013000 if UART_SIFIVE && PLATFORM_SIFIVE_E
	default 0x807FF000 if UART_HTIF
	default 0x00011300 if UART_SHAKTI
	default 0x40600000 if UART_UARTLITE
	default 0x40000000 if UART_IBEX
	default 0x40000000 if PLATFORM_OPENTITAN
	default 0x00000000
	help
	  Spike HTIF: absolute address of ELF `tohost` (must match harness
	  link_exec.ld /.tohost @ 0x807FF000; QEMU parses the symbol).
	  VisionFive 2: UART0 snps,dw-apb-uart @ 0x10000000 (115200 after U-Boot).

config UART_IRQ
	int "UART PLIC IRQ number"
	default 10 if PLATFORM_VIRT || PLATFORM_XIANGSHAN
	default 4 if PLATFORM_SIFIVE_U || PLATFORM_AMD_MICROBLAZE_V
	default 3 if PLATFORM_SIFIVE_E
	default 32 if PLATFORM_VISIONFIVE2 || PLATFORM_MILKV_MARS
	default 90 if PLATFORM_MICROCHIP_ICICLE
	default 0
	help
	  PLIC source for the console UART. Icicle MMUART0 = 90. Shakti QEMU
	  does not connect UART to PLIC — leave 0.

config UART_REG_SHIFT
	int "16550 register shift (0=byte, 2=word-spaced)"
	depends on UART_16550
	default 2 if PLATFORM_VISIONFIVE2 || PLATFORM_MILKV_MARS
	default 2 if PLATFORM_XIANGSHAN
	default 2 if PLATFORM_MICROCHIP_ICICLE
	default 0
	help
	  NS16550 register index stride as a shift: offset = idx << UART_REG_SHIFT.
	  QEMU virt is byte-wide (0). VisionFive 2 DW8250, Xiangshan, and Icicle
	  MMUART (serial-mm) use reg-shift=2 (word). THR stays at BASE+0 either
	  way; LSR/RBR spacing matters for RX and TX-ready (THRE) waits.

endmenu

menu "SiFive reset / power (RVSifivePlat)"

config SIFIVE_TEST_BASE
	hex "SiFive test finisher base (0 = absent)"
	default 0x00100000 if PLATFORM_VIRT
	default 0
	help
	  SiFive test-finisher MMIO (U32 poke): 0x7777 reset, 0x5555 pass/off,
	  0x3333 fail. Present on the virt harness map at 0x100000 — not on
	  sifive_u / sifive_e (those use GPIO or AON below). Real FU540/FE310
	  silicon does not implement this device.

config SIFIVE_AON_BASE
	hex "SiFive AON base (0 = absent)"
	default 0x10000000 if PLATFORM_SIFIVE_E
	default 0
	help
	  Always-On block (WDT + PMU). FE310 / sifive_e: 0x10000000.
	  sifive_u must leave this 0 — that address is PRCI on FU540 maps, not AON.
	  RVSifiveReset uses AON WDT (key 0x51F15E, RSTEN) when non-zero.

config SIFIVE_GPIO_BASE
	hex "SiFive GPIO base (0 = absent)"
	default 0x10060000 if PLATFORM_SIFIVE_U
	default 0x10012000 if PLATFORM_SIFIVE_E
	default 0
	help
	  SiFive GPIO MMIO. sifive_u: 0x10060000. FE310: 0x10012000.

config SIFIVE_GPIO_RESET_PIN
	int "GPIO active-low board-reset pin (32 = none)"
	default 10 if PLATFORM_SIFIVE_U
	default 32
	help
	  Pin driven low to request board reset. sifive_u (HiFive Unleashed style)
	  wires GPIO 10 as active-low restart. 32 disables the GPIO reset path.

config SIFIVE_UART1_BASE
	hex "SiFive UART1 base (0 = absent)"
	default 0x10011000 if PLATFORM_SIFIVE_U
	default 0
	help
	  Second SiFive UART0-compatible port (FU540 UART1). Legend / future
	  console; plat console stays on UART0 @ UART_BASE.

config SIFIVE_PRCI_BASE
	hex "SiFive PRCI base (0 = absent)"
	default 0x10000000 if PLATFORM_SIFIVE_U
	default 0
	help
	  Power Reset Clock Interface (FU540). MemMap legend only — do not
	  confuse with FE310 AON at the same address on sifive_e.

config SIFIVE_ETH_BASE
	hex "SiFive GEM ethernet base (0 = absent / stub)"
	default 0x10090000 if PLATFORM_SIFIVE_U
	default 0
	help
	  Cadence GEM on FU540 @ 0x10090000. Non-zero selects RVSifiveGemYes
	  (poll TX/RX + local-loopback self-test). Zero → RVSifiveGemNo.

endmenu

menu "Timer / interrupt controller"

config HAS_CLINT
	bool "SiFive-style CLINT / ACLINT present"
	default n if PLATFORM_AMD_MICROBLAZE_V
	default n if PLATFORM_OPENTITAN
	default y
	help
	  When disabled, timer select falls through to HAS_IBEX_TIMER /
	  HAS_XPS_TIMER or RVTimerStub. Needed off for amd-microblaze-v and
	  OpenTitan.

config CLINT_BASE
	hex "CLINT base"
	default 0x38000000 if PLATFORM_XIANGSHAN
	default 0x02000000 if PLATFORM_MICROCHIP_ICICLE
	default 0x02000000 if PLATFORM_SHAKTI_C
	default 0x02000000
	help
	  SiFive CLINT / ACLINT SWI base: mtime @ +0xBFF8, mtimecmp hart0 @ +0x4000
	  (QEMU ACLINT mtimer is mapped at BASE+0x4000 with the same relative
	  offsets — Shakti + Icicle match). Xiangshan ACLINT @ 0x38000000.
	  Ignored when HAS_CLINT=n.

config CLINT_MTIME_OFF
	hex "mtime offset from CLINT"
	default 0xBFF8

config CLINT_MTIMECMP_OFF
	hex "mtimecmp hart0 offset from CLINT"
	default 0x4000

config HAS_IBEX_TIMER
	bool "OpenTitan / Ibex rv_timer (HolyC RVTimerIbex)"
	default y if PLATFORM_OPENTITAN
	default n
	depends on !HAS_CLINT
	help
	  Selects Kernel/Drv/RVTimerIbex.HC (CTRL/LOWER/COMPARE @ IBEX_TIMER_BASE).
	  QEMU ibex_timer default timebase is 10 kHz — set TIMEBASE_FREQ to match.

config IBEX_TIMER_BASE
	hex "Ibex rv_timer base"
	default 0x40100000
	depends on HAS_IBEX_TIMER

config HAS_XPS_TIMER
	bool "Xilinx XPS Timer (HolyC RVTimerXps)"
	default y if PLATFORM_AMD_MICROBLAZE_V
	default n
	depends on !HAS_CLINT && !HAS_IBEX_TIMER
	help
	  Selects Kernel/Drv/RVTimerXps.HC for QEMU amd-microblaze-v-generic
	  xlnx.xps-timer @ XPS_TIMER_BASE (100 MHz). Timer0 free-run, Timer1 one-shot.

config XPS_TIMER_BASE
	hex "XPS timer base"
	default 0x41C00000 if PLATFORM_AMD_MICROBLAZE_V
	default 0x41C00000
	depends on HAS_XPS_TIMER

config HAS_PLIC
	bool "Platform has a SiFive-style PLIC"
	default y if PLATFORM_VIRT
	default y if PLATFORM_SIFIVE_U
	default y if PLATFORM_SIFIVE_E
	default y if PLATFORM_SHAKTI_C
	default y if PLATFORM_MICROCHIP_ICICLE
	default y if PLATFORM_OPENTITAN
	default y if PLATFORM_VISIONFIVE2 || PLATFORM_MILKV_MARS
	default n
	help
	  SiFive-style PLIC. Mutually exclusive with HAS_APLIC / HAS_XPS_INTC
	  for Selected.HH. Xiangshan uses APLIC/IMSIC; amd-microblaze-v uses XPS INTC.

config PLIC_BASE
	hex "PLIC base"
	default 0x48000000 if PLATFORM_OPENTITAN
	default 0x0C000000
	depends on HAS_PLIC

config PLIC_ENABLE_OFF
	hex "PLIC context-0 enable offset"
	default 0x2000
	depends on HAS_PLIC

config PLIC_THRESHOLD_OFF
	hex "PLIC context-0 threshold offset"
	default 0x200000
	depends on HAS_PLIC

config PLIC_CLAIM_OFF
	hex "PLIC context-0 claim/complete offset"
	default 0x200004
	depends on HAS_PLIC

config HAS_APLIC
	bool "AIA APLIC (Xiangshan / MSI→IMSIC)"
	default y if PLATFORM_XIANGSHAN
	default n
	depends on !HAS_PLIC
	help
	  Selects Kernel/Drv/RVPlicAplic.HC. Same RVPlic* API; Claim via CSR
	  mtopei. QEMU xiangshan APLIC_M @ 0x31100000, IMSIC_M @ 0x3A800000.
	  Mutually exclusive with HAS_XPS_INTC via Selected.HH.

config APLIC_BASE
	hex "APLIC M-mode base"
	default 0x31100000 if PLATFORM_XIANGSHAN
	default 0x31100000
	depends on HAS_APLIC

config IMSIC_BASE
	hex "IMSIC M-mode base (MemMap + MSI file stride legend)"
	default 0x3A800000 if PLATFORM_XIANGSHAN
	default 0x3A800000
	depends on HAS_APLIC

config HAS_XPS_INTC
	bool "Xilinx XPS INTC (HolyC RVPlicXps)"
	default y if PLATFORM_AMD_MICROBLAZE_V
	default n
	depends on !HAS_PLIC && !HAS_APLIC
	help
	  Selects Kernel/Drv/RVPlicXps.HC for QEMU amd-microblaze-v-generic
	  xlnx.xps-intc @ XPS_INTC_BASE. IRQ0=timer, IRQ1=UARTLite.

config XPS_INTC_BASE
	hex "XPS INTC base"
	default 0x41200000 if PLATFORM_AMD_MICROBLAZE_V
	default 0x41200000
	depends on HAS_XPS_INTC

config TIMEBASE_FREQ
	int "Timer timebase frequency (Hz)"
	default 10000000 if PLATFORM_VIRT
	default 10000000 if PLATFORM_SHAKTI_C
	default 1000000 if PLATFORM_SIFIVE_U || PLATFORM_SIFIVE_E || PLATFORM_XIANGSHAN
	default 1000000 if PLATFORM_MICROCHIP_ICICLE
	default 4000000 if PLATFORM_VISIONFIVE2 || PLATFORM_MILKV_MARS
	default 10000 if PLATFORM_OPENTITAN
	default 100000000 if PLATFORM_AMD_MICROBLAZE_V
	default 10000000
	help
	  ACLINT/CLINT mtime tick rate. Shakti ACLINT default 10 MHz; Icicle
	  PolarFire ACLINT 1 MHz (QEMU qtree timebase-freq). XPS timer on
	  amd-microblaze-v is 100 MHz.

endmenu

menu "VirtIO / storage"

config HAS_VIRTIO_MMIO
	bool "VirtIO MMIO slots present"
	default y if PLATFORM_VIRT
	default n
	help
	  QEMU virt maps virtio-mmio at 0x10001000 + n*0x1000.

config VIRTIO_MMIO_BASE
	hex "First virtio-mmio base"
	default 0x10001000
	depends on HAS_VIRTIO_MMIO

config VIRTIO_MMIO_STRIDE
	hex "virtio-mmio slot stride"
	default 0x1000
	depends on HAS_VIRTIO_MMIO

config VIRTIO_MMIO_COUNT
	int "Number of virtio-mmio slots to scan"
	default 8
	depends on HAS_VIRTIO_MMIO

config VIRTIO_MMIO_IRQ_BASE
	hex "Address base for virtio-mmio → PLIC IRQ derivation"
	default 0x10000000
	depends on HAS_VIRTIO_MMIO
	help
	  On QEMU virt, IRQ = (mmio_slot_base - VIRTIO_MMIO_IRQ_BASE) >> 12
	  (e.g. 0x10008000 → IRQ 8). Used by VirtioBlkIrqInit / VirtioNetIrqNum.

config VIRTIO_DRV_RAM_BASE
	hex "Virtio HolyC driver scratch RAM base"
	default 0x88000000
	depends on HAS_VIRTIO_MMIO
	help
	  Descriptor rings + bounce buffers for DskVirtioRV / VirtioNet /
	  VirtioInput / Virtio9p / VirtioConsole / VirtioBalloon / VirtioScsi.
	  Needs QEMU -m >= 256M so 0x88000000 is backed on virt.
	  Layout: blk @ +0, net @ +0x100000, input @ +0x200000, 9p @ +0x300000,
	  pci-blk @ +0x400000, pci-9p @ +0x500000, pci-net @ +0x600000,
	  console @ +0x700000, balloon @ +0x800000, scsi @ +0x900000.

config HAS_VIRTIO_PCI
	bool "VirtIO PCI (ECAM) present"
	default y if PLATFORM_VIRT
	default n
	help
	  QEMU virt PCI ECAM + virtio-pci. HolyC: VirtioPci.HC / VirtioPciBlk.HC
	  (modern caps + LBA read) and NinePVirtioPci find/handshake. MMIO blk/net
	  remain the default product path.

config PCI_ECAM_BASE
	hex "PCI Express ECAM base"
	default 0x30000000
	depends on HAS_VIRTIO_PCI
	help
	  QEMU virt maps ECAM at 0x30000000 (see DTB pcie node).

config PCI_MMIO_ASSIGN_BASE
	hex "BAR assign base for -bios none virtio-pci"
	default 0x48000000
	depends on HAS_VIRTIO_PCI
	help
	  When QEMU leaves virtio BAR4 unassigned, HolyC maps it here inside the
	  virt PCIe MMIO window (0x40000000..).

config HAS_VIRTIO_NET
	bool "HolyC virtio-mmio net driver (VirtioNet.HC)"
	depends on HAS_VIRTIO_MMIO
	default y if PLATFORM_VIRT
	default n
	help
	  Include Kernel/Drv/VirtioNet.HC TX/RX. Needs a virtio-net-device
	  attached on a virtio-mmio slot (e.g. harness -device virtio-net-device).

config HAS_VIRTIO_INPUT
