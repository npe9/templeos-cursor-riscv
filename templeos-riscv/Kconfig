#
# TempleOS/RISC-V — platform / QEMU machine configuration
#
# Usage (from repo root or templeos-riscv/):
#   make -C templeos-riscv menuconfig
#   make -C templeos-riscv defconfig              # virt (default)
#   make -C templeos-riscv defconfig-sifive_u
#
# Generates: .config, include/generated/autoconf.h, ../Kernel/RVAutoConf.HH
#

mainmenu "TempleOS/RISC-V Platform Configuration"

source "Kconfig.machines"

menu "Memory map / link"

config DRAM_BASE
	hex "DRAM base (physical)"
	default 0x10000000 if PLATFORM_OPENTITAN
	default 0x80000000
	help
	  Physical base of main RAM. Most QEMU boards use 0x80000000;
	  OpenTitan uses 0x10000000 (128 KiB SRAM).

config DRAM_SIZE
	hex "DRAM size (bytes)"
	default 0x00020000 if PLATFORM_OPENTITAN
	default 0x00004000 if PLATFORM_SIFIVE_E
	default 0x08000000
	help
	  Size of main RAM region for linker scripts (default 128 MiB for virt smokes;
	  sifive_e / opentitan are tiny — full images do not fit).

config KERNEL_ENTRY
	hex "Kernel entry / -kernel load address"
	default 0x10000000 if PLATFORM_OPENTITAN
	default 0x80000000
	help
	  Address QEMU jumps to with -bios none -kernel. Must match linker ORIGIN.

config KERNEL_LINK_ADDR
	hex "Kernel link / VMA base"
	default 0x10000000 if PLATFORM_OPENTITAN
	default 0x80000000
	help
	  Linker VMA for .text (usually same as KERNEL_ENTRY on bare metal).

config GUEST_BLOB_ADDR
	hex "HolyC guest blob VMA (templeos-riscv)"
	default 0x10010000 if PLATFORM_OPENTITAN
	default 0x80100000

config COMPILER_SLOT_ADDR
	hex "Compiler slot VMA"
	default 0x10018000 if PLATFORM_OPENTITAN
	default 0x80200000

config TOS_API_ADDR
	hex "TosApi VMA"
	default 0x1001C000 if PLATFORM_OPENTITAN
	default 0x80300000

config SYS_FIXED_AREA
	hex "SYS_FIXED_AREA (HolyC FPU save page)"
	default 0x1001F000 if PLATFORM_OPENTITAN
	default 0x87000000
	help
	  RISC-V stand-in for x86 SYS_FIXED_AREA; must be real RAM.

config FB_SOFT_BASE
	hex "Software framebuffer base (RVFb soft buffer)"
	default 0x1001E000 if PLATFORM_OPENTITAN
	default 0x86100000
	depends on FB_PRESENT_RAMFB || FB_PRESENT_SIMPLEFB || FB_PRESENT_NONE

config HEAP_BASE
	hex "HolyC soft heap base (REPL / seed MEM_HEAP)"
	default 0x1001A000 if PLATFORM_OPENTITAN
	default 0x86000000
	help
	  Soft heap arena used by REPL seed mem.hc. Must be inside DRAM.

config MEMFS_BASE
	hex "HolyC memfs arena base (seed MEM_FS)"
	default 0x1001B000 if PLATFORM_OPENTITAN
	default 0x87800000
	help
	  In-RAM memfs for FileRead/FileWrite. Needs DRAM large enough
	  (virt default 128 MiB reaches 0x87800000).

config HOST_SLOTS_BASE
	hex "Transitional REPL host-slots page (seed MEM_HOST_SLOTS)"
	default 0x87001000
	help
	  Fixed page for Mac-AOT REPL C↔HolyC ABI (compile/run funptrs,
	  UART ring metadata, trapvec, editors). This is NOT board MMIO —
	  it must stay stable while worry_dream_repl publishes slots. Board
	  ports that drop the transitional REPL can ignore it; Kernel OS
	  paths prefer CONFIG_* / Hash over slots.

config SMP_MAILBOX_BASE
	hex "Multi-hart SMP mailbox base (RVSmp / crt0_smp)"
	default 0x87001E00
	help
	  Shared mailbox near SYS_FIXED_AREA: entry/arg/done/alive.
	  Must match tests/exec/harness/crt0_smp.S .equ values.

config STACK_BASE
	hex "Initial stack top hint (seed MEM_STACK)"
	default 0x1001F800 if PLATFORM_OPENTITAN
	default 0x87F00000
	help
	  Documentation / MemMap legend for early stack; linker scripts
	  own the real stack symbol.

endmenu

menu "UART console"

choice
	prompt "UART driver"
	default UART_16550 if PLATFORM_VIRT
	default UART_16550 if PLATFORM_XIANGSHAN
	default UART_16550 if PLATFORM_AMD_MICROBLAZE_V
	default UART_16550 if PLATFORM_MICROCHIP_ICICLE
	default UART_SIFIVE if PLATFORM_SIFIVE_U
	default UART_SIFIVE if PLATFORM_SIFIVE_E
	default UART_HTIF if PLATFORM_SPIKE
	default UART_STUB

config UART_16550
	bool "NS16550A (QEMU virt / best-guess)"
	help
	  Byte-wide 16550 at UART_BASE. virt: 0x10000000. Boards with regshift=2
	  (xiangshan, amd-microblaze 16550) may need a spaced driver for RX;
	  TX-to-base often still works for tentative hello.

config UART_SIFIVE
	bool "SiFive UART0"
	help
	  Word-wide SiFive UART (sifive_u: 0x10010000, sifive_e: 0x10013000).

config UART_HTIF
	bool "Spike HTIF console (experimental)"
	help
	  Character I/O via Spike/QEMU HTIF. Experimental — not used by CI.

config UART_STUB
	bool "Stub (no console hardware)"
	help
	  Compiles; putc is a no-op. For boards without a known console yet
	  (Shakti UART, Ibex UART, UARTLite primary, etc.).

endchoice

config UART_BASE
	hex "UART MMIO base"
	default 0x10000000 if UART_16550 && PLATFORM_VIRT
	default 0x310B0000 if UART_16550 && PLATFORM_XIANGSHAN
	default 0x44A11000 if UART_16550 && PLATFORM_AMD_MICROBLAZE_V
	default 0x20000000 if UART_16550 && PLATFORM_MICROCHIP_ICICLE
	default 0x10000000 if UART_16550
	default 0x10010000 if UART_SIFIVE && PLATFORM_SIFIVE_U
	default 0x10013000 if UART_SIFIVE && PLATFORM_SIFIVE_E
	default 0x807FF000 if UART_HTIF
	default 0x00011300 if PLATFORM_SHAKTI_C
	default 0x40000000 if PLATFORM_OPENTITAN
	default 0x00000000
	help
	  Spike HTIF: absolute address of ELF `tohost` (must match harness
	  link_exec.ld /.tohost @ 0x807FF000; QEMU parses the symbol).

config UART_IRQ
	int "UART PLIC IRQ number"
	default 10 if PLATFORM_VIRT || PLATFORM_XIANGSHAN
	default 4 if PLATFORM_SIFIVE_U || PLATFORM_AMD_MICROBLAZE_V
	default 3 if PLATFORM_SIFIVE_E
	default 0

endmenu

menu "SiFive reset / power (RVSifivePlat)"

config SIFIVE_TEST_BASE
	hex "SiFive test finisher base (0 = absent)"
	default 0x00100000 if PLATFORM_VIRT
	default 0
	help
	  SiFive test-finisher MMIO (U32 poke): 0x7777 reset, 0x5555 pass/off,
	  0x3333 fail. Present on the virt harness map at 0x100000 — not on
	  sifive_u / sifive_e (those use GPIO or AON below). Real FU540/FE310
	  silicon does not implement this device.

config SIFIVE_AON_BASE
	hex "SiFive AON base (0 = absent)"
	default 0x10000000 if PLATFORM_SIFIVE_E
	default 0
	help
	  Always-On block (WDT + PMU). FE310 / sifive_e: 0x10000000.
	  sifive_u must leave this 0 — that address is PRCI on FU540 maps, not AON.
	  RVSifiveReset uses AON WDT (key 0x51F15E, RSTEN) when non-zero.

config SIFIVE_GPIO_BASE
	hex "SiFive GPIO base (0 = absent)"
	default 0x10060000 if PLATFORM_SIFIVE_U
	default 0x10012000 if PLATFORM_SIFIVE_E
	default 0
	help
	  SiFive GPIO MMIO. sifive_u: 0x10060000. FE310: 0x10012000.

config SIFIVE_GPIO_RESET_PIN
	int "GPIO active-low board-reset pin (32 = none)"
	default 10 if PLATFORM_SIFIVE_U
	default 32
	help
	  Pin driven low to request board reset. sifive_u (HiFive Unleashed style)
	  wires GPIO 10 as active-low restart. 32 disables the GPIO reset path.

endmenu

menu "Timer / interrupt controller"

config CLINT_BASE
	hex "CLINT base"
	default 0x38000000 if PLATFORM_XIANGSHAN
	default 0x02000000 if PLATFORM_MICROCHIP_ICICLE
	default 0x02000000
	help
	  SiFive CLINT: mtime @ +0xBFF8, mtimecmp hart0 @ +0x4000.
	  Xiangshan uses ACLINT @ 0x38000000 (mtime layout may differ — tentative).
	  OpenTitan / amd-microblaze-v have no SiFive CLINT.

config CLINT_MTIME_OFF
	hex "mtime offset from CLINT"
	default 0xBFF8

config CLINT_MTIMECMP_OFF
	hex "mtimecmp hart0 offset from CLINT"
	default 0x4000

config HAS_PLIC
	bool "Platform has a PLIC"
	default y if PLATFORM_VIRT
	default y if PLATFORM_SIFIVE_U
	default y if PLATFORM_SIFIVE_E
	default y if PLATFORM_SHAKTI_C
	default y if PLATFORM_MICROCHIP_ICICLE
	default y if PLATFORM_OPENTITAN
	default n
	help
	  SiFive-style PLIC. Xiangshan uses APLIC/IMSIC; amd-microblaze-v uses
	  AXI INTC — leave off and use PLIC stub.

config PLIC_BASE
	hex "PLIC base"
	default 0x48000000 if PLATFORM_OPENTITAN
	default 0x0C000000
	depends on HAS_PLIC

config PLIC_ENABLE_OFF
	hex "PLIC context-0 enable offset"
	default 0x2000
	depends on HAS_PLIC

config PLIC_THRESHOLD_OFF
	hex "PLIC context-0 threshold offset"
	default 0x200000
	depends on HAS_PLIC

config PLIC_CLAIM_OFF
	hex "PLIC context-0 claim/complete offset"
	default 0x200004
	depends on HAS_PLIC

config TIMEBASE_FREQ
	int "Timer timebase frequency (Hz)"
	default 10000000 if PLATFORM_VIRT
	default 1000000 if PLATFORM_SIFIVE_U || PLATFORM_SIFIVE_E || PLATFORM_XIANGSHAN
	default 10000000

endmenu

menu "VirtIO / storage"

config HAS_VIRTIO_MMIO
	bool "VirtIO MMIO slots present"
	default y if PLATFORM_VIRT
	default n
	help
	  QEMU virt maps virtio-mmio at 0x10001000 + n*0x1000.

config VIRTIO_MMIO_BASE
	hex "First virtio-mmio base"
	default 0x10001000
	depends on HAS_VIRTIO_MMIO

config VIRTIO_MMIO_STRIDE
	hex "virtio-mmio slot stride"
	default 0x1000
	depends on HAS_VIRTIO_MMIO

config VIRTIO_MMIO_COUNT
	int "Number of virtio-mmio slots to scan"
	default 8
	depends on HAS_VIRTIO_MMIO

config VIRTIO_MMIO_IRQ_BASE
	hex "Address base for virtio-mmio → PLIC IRQ derivation"
	default 0x10000000
	depends on HAS_VIRTIO_MMIO
	help
	  On QEMU virt, IRQ = (mmio_slot_base - VIRTIO_MMIO_IRQ_BASE) >> 12
	  (e.g. 0x10008000 → IRQ 8). Used by VirtioBlkIrqInit / VirtioNetIrqNum.

config VIRTIO_DRV_RAM_BASE
	hex "Virtio HolyC driver scratch RAM base"
	default 0x88000000
	depends on HAS_VIRTIO_MMIO
	help
	  Descriptor rings + bounce buffers for DskVirtioRV / VirtioNet /
	  VirtioInput. Needs QEMU -m >= 256M so 0x88000000 is backed on virt.
	  Layout: blk @ +0, net @ +0x100000, input @ +0x200000, 9p @ +0x300000.

config HAS_VIRTIO_PCI
	bool "VirtIO PCI (ECAM) present"
	default y if PLATFORM_VIRT
	default n
	help
	  QEMU virt PCI ECAM + virtio-pci. Other machines: usually n.
	  HolyC still drives virtio-blk over MMIO; PCI present is a Kconfig flag
	  only (no HolyC virtio-PCI blk driver yet).

config HAS_VIRTIO_NET
	bool "HolyC virtio-mmio net driver (VirtioNet.HC)"
	depends on HAS_VIRTIO_MMIO
	default y if PLATFORM_VIRT
	default n
	help
	  Include Kernel/Drv/VirtioNet.HC TX/RX. Needs a virtio-net-device
	  attached on a virtio-mmio slot (e.g. harness -device virtio-net-device).

config HAS_VIRTIO_INPUT
	bool "HolyC virtio-mmio input driver (VirtioInput.HC)"
	depends on HAS_VIRTIO_MMIO
	default y if PLATFORM_VIRT
	default n
	help
	  Include Kernel/Drv/VirtioInput.HC event poll. Attach
	  virtio-keyboard-device / virtio-mouse-device on virtio-mmio.

config HAS_VIRTIO_9P
	bool "HolyC virtio-mmio 9p client (Virtio9p.HC)"
	depends on HAS_VIRTIO_MMIO
	default y if PLATFORM_VIRT
	default n
	help
	  Include Kernel/Drv/Virtio9p.HC 9P2000.L client. Attach QEMU
	  -virtfs / -fsdev with virtio-9p-device (mount host dir into guest).
	  Guest-as-9p-server export is not implemented yet.

endmenu

menu "Framebuffer present"

choice
	prompt "FB present backend"
	default FB_PRESENT_RAMFB if PLATFORM_VIRT
	default FB_PRESENT_NONE

config FB_PRESENT_RAMFB
	bool "QEMU ramfb via fw_cfg"
	depends on HAS_FW_CFG
	help
	  Default on virt. Needs -device ramfb. See BOARD_FB.md.

config FB_PRESENT_SIMPLEFB
	bool "simple-framebuffer bind hook"
	help
	  Board calls RVFbSimpleFbBind after firmware leaves XR24 scanout.
	  Optional SIMPLEFB_* constants below auto-bind at boot when non-zero.
	  virtio-gpu / SoC DRM are deferred — see BOARD_FB.md.

config FB_PRESENT_NONE
	bool "None (soft buffer / UART-only)"
	help
	  No hardware present; RVFb draws to soft buffer only.

endchoice

config SIMPLEFB_BASE
	hex "Board simplefb phys base (0 = manual RVFbSimpleFbBind only)"
	depends on FB_PRESENT_SIMPLEFB
	default 0x0
	help
	  Identity-mapped XR24 scanout left by firmware/U-Boot. 0 disables
	  RVFbSimpleFbTryBoard auto-bind.

config SIMPLEFB_WIDTH
	int "Board simplefb width"
	depends on FB_PRESENT_SIMPLEFB
	default 0

config SIMPLEFB_HEIGHT
	int "Board simplefb height"
	depends on FB_PRESENT_SIMPLEFB
	default 0

config SIMPLEFB_STRIDE
	int "Board simplefb stride (bytes; 0 = width*4)"
	depends on FB_PRESENT_SIMPLEFB
	default 0

config HAS_FW_CFG
	bool "QEMU fw_cfg MMIO present"
	default y if PLATFORM_VIRT
	default n

config FW_CFG_BASE
	hex "fw_cfg MMIO base"
	default 0x10100000
	depends on HAS_FW_CFG

config HAS_GOLDFISH_RTC
	bool "Goldfish RTC present"
	default y if PLATFORM_VIRT
	default n

config RTC_BASE
	hex "Goldfish RTC base"
	default 0x00101000
	depends on HAS_GOLDFISH_RTC

endmenu

menu "Editors"

choice
	prompt "Default Src / DirEd / FunEd editor"
	default EDITOR_VI
	help
	  Sets the HolyC `editor` function pointer used by Src(), DirEd(), FunEd(),
	  and Activate. Generated into Kernel/RVAutoConf.HH and
	  bootstrap/seed/RVEditorSelected.hc (REPL boot). Override live with
	  editor=&Vi; / editor=&EditHoly; / editor=&EdHoly;

config EDITOR_VI
	bool "Vi (modal vim-lite)"
	help
	  Default. HolyC Vi — Tab indents with 2 spaces (holyc_fmt); :w/:q.

config EDITOR_EDIT
	bool "Edit (full-screen / nano-style)"
	help
	  HolyC EditHoly — type to insert, ^O save, ^X exit.

config EDITOR_ED
	bool "Ed (line editor)"
	help
	  HolyC EdHoly — classic ed addresses and a/i/d/p/w/q.

endchoice

endmenu

menu "Boot / kernel output"

choice
	prompt "Kernel output format"
	default OUTPUT_FORMAT_ELF
	help
	  Select the primary boot artifact for kernel / plat builds.
	  ELF is the CI default (-bios none -kernel plat.elf). Firmware wraps
	  the same RAM-linked payload in a flash head for pflash / -bios.

config OUTPUT_FORMAT_ELF
	bool "ELF (-kernel load)"
	help
	  Normal RAM-linked ELF loaded by QEMU -bios none -kernel or the
	  exec harness link_exec.ld path. Default for all CI smokes.

config OUTPUT_FORMAT_FIRMWARE
	bool "Firmware ROM image (pflash / -bios)"
	help
	  Package the RAM payload in a flash-resident stub (bootstrap/
	  Makefile.firmware). Produces a padded .bin at FLASH_BASE for
	  QEMU -drive if=pflash or -bios. plat.elf is still built for debug.

endchoice

config FLASH_BASE
	hex "Flash image base (physical)"
	default 0x20000000
	depends on OUTPUT_FORMAT_FIRMWARE
	help
	  Physical base of the firmware image (QEMU virt CFI pflash0 @ 0x20000000).

config PFLASH_SIZE
	hex "Pflash partition size (bytes)"
	default 0x02000000
	depends on OUTPUT_FORMAT_FIRMWARE
	help
	  Raw .bin is zero-padded to this size (virt pflash0 is 32 MiB).

endmenu

menu "QEMU run helpers"

config QEMU_SYSTEM
	string "QEMU system binary"
	default "qemu-system-riscv32" if PLATFORM_OPENTITAN
	default "qemu-system-riscv64"
	help
	  OpenTitan is riscv32-only. All other in-tree ports use riscv64.

config QEMU_MACHINE
	string "QEMU -M machine name"
	default "virt" if PLATFORM_VIRT
	default "sifive_u" if PLATFORM_SIFIVE_U
	default "sifive_e" if PLATFORM_SIFIVE_E
	default "spike" if PLATFORM_SPIKE
	default "shakti_c" if PLATFORM_SHAKTI_C
	default "microchip-icicle-kit" if PLATFORM_MICROCHIP_ICICLE
	default "xiangshan-kunminghu" if PLATFORM_XIANGSHAN
	default "amd-microblaze-v-generic" if PLATFORM_AMD_MICROBLAZE_V
	default "opentitan" if PLATFORM_OPENTITAN
	default "none" if PLATFORM_NONE
	default "host" if PLATFORM_HOST
	default "virt"

config QEMU_EXTRA_ARGS
	string "Extra QEMU args (documentation / scripts)"
	default "-serial null -serial mon:stdio -bios none" if PLATFORM_AMD_MICROBLAZE_V
	default "-bios none" if PLATFORM_VIRT
	default "-bios none" if PLATFORM_SIFIVE_U
	default "-bios none" if PLATFORM_SIFIVE_E
	default "-bios none" if PLATFORM_SPIKE
	default "-bios none" if PLATFORM_SHAKTI_C
	default "-bios none" if PLATFORM_XIANGSHAN
	default "-bios none" if PLATFORM_OPENTITAN
	default ""
	help
	  microchip-icicle-kit needs HSS (hss.bin) — leave empty and supply firmware.
	  amd-microblaze-v: serial0 is UARTLite; serial1 is 16550 — mux for 16550 console.
	  none / host: no useful bare-metal argv.

endmenu
