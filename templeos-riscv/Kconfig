menu "Boot / kernel output"

choice
	prompt "Kernel output format"
	default OUTPUT_FORMAT_ELF
	help
	  Select the primary boot artifact for kernel / plat builds.
	  ELF is the CI default (-bios none -kernel plat.elf). Firmware wraps
	  the same RAM-linked payload in a flash head for pflash / -bios.

config OUTPUT_FORMAT_ELF
	bool "ELF (-kernel load)"
	help
	  Normal RAM-linked ELF loaded by QEMU -bios none -kernel or the
	  exec harness link_exec.ld path. Default for all CI smokes.

config OUTPUT_FORMAT_FIRMWARE
	bool "Firmware ROM image (pflash / -bios)"
	help
	  Package the RAM payload in a flash-resident stub (bootstrap/
	  Makefile.firmware). Produces a padded .bin at FLASH_BASE for
	  QEMU -drive if=pflash or -bios. plat.elf is still built for debug.

endchoice

config FLASH_BASE
	hex "Flash image base (physical)"
	default 0x20000000
	depends on OUTPUT_FORMAT_FIRMWARE
	help
	  Physical base of the firmware image (QEMU virt CFI pflash0 @ 0x20000000).

config PFLASH_SIZE
	hex "Pflash partition size (bytes)"
	default 0x02000000
	depends on OUTPUT_FORMAT_FIRMWARE || BOOT_SPLIT
	help
	  Raw .bin is zero-padded to this size (virt pflash0 is 32 MiB).

config BOOT_SPLIT
	bool "Split bootloader + RAM payload"
	default n
	help
	  Build a tiny bootloader separately from the REPL/kernel RAM image.
	  Use make bootloader / bootloader-repl / bootloader-smoke.
	  Jump mode: bootloader only jumps to ENTRY_POINT (load payload separately).
	  Copy mode: embed flat payload and copy to ENTRY_POINT (like Firmware ROM).
	  See docs/BAREMETAL.md § Split bootloader + REPL.

config BOOTLOADER_BASE
	hex "Bootloader link / reset base"
	default 0x20000000
	depends on BOOT_SPLIT
	help
	  Link address for build/bootloader/boot.{elf,bin}.
	  QEMU virt CFI pflash0 is 0x20000000 (preferred with -bios none -drive if=pflash).
	  For dual-DRAM loader jump mode, use 0x80000000 (virt reset) and link the
	  payload at a higher ENTRY_POINT (e.g. 0x80200000).

choice
	prompt "Bootloader mode"
	depends on BOOT_SPLIT
	default BOOT_MODE_JUMP
	help
	  Jump: payload already at ENTRY_POINT. Copy: stub embeds and relocates it.

config BOOT_MODE_JUMP
	bool "Jump (payload already at ENTRY_POINT)"
	help
	  Tiny stub: hart0 disables IRQs and jumps to ENTRY_POINT.
	  QEMU: pflash boot.bin + -device loader for repl.bin @ ENTRY_POINT.

config BOOT_MODE_COPY
	bool "Copy (embed payload, copy to ENTRY_POINT)"
	help
	  Same pattern as make firmware / firmware_stub.S: copy embedded flat
	  image to ENTRY_POINT then jump. Prefer make firmware for a single
	  combined ROM when you do not need a separate boot.bin.

endchoice

endmenu

menu "QEMU run helpers"

config QEMU_SYSTEM
	string "QEMU system binary"
	default "qemu-system-riscv32" if ARCH_RISCV32
	default "qemu-system-riscv32" if PLATFORM_OPENTITAN
	default "qemu-system-riscv64"
	help
	  Use qemu-system-riscv32 when ARCH_RISCV32 or OpenTitan. CI default
	  boards stay on qemu-system-riscv64.

config QEMU_MACHINE
	string "QEMU -M machine name"
	default "virt" if PLATFORM_VIRT
	default "sifive_u" if PLATFORM_SIFIVE_U
	default "sifive_e" if PLATFORM_SIFIVE_E
	default "spike" if PLATFORM_SPIKE
	default "shakti_c" if PLATFORM_SHAKTI_C
	default "microchip-icicle-kit" if PLATFORM_MICROCHIP_ICICLE
	default "xiangshan-kunminghu" if PLATFORM_XIANGSHAN
	default "amd-microblaze-v-generic" if PLATFORM_AMD_MICROBLAZE_V
	default "opentitan" if PLATFORM_OPENTITAN
	default "none" if PLATFORM_NONE
	default "host" if PLATFORM_HOST
	default "board-only" if PLATFORM_VISIONFIVE2 || PLATFORM_MILKV_MARS
	default "virt"

config QEMU_LOAD_MODE
	string "How plat smoke loads the ELF"
	default "kernel" if PLATFORM_VIRT
	default "kernel" if PLATFORM_SIFIVE_U
	default "kernel" if PLATFORM_SIFIVE_E
	default "kernel" if PLATFORM_SPIKE
	default "kernel" if PLATFORM_MICROCHIP_ICICLE
	default "bios" if PLATFORM_SHAKTI_C
	default "bios" if PLATFORM_XIANGSHAN
	default "loader" if PLATFORM_AMD_MICROBLAZE_V
	default "kernel" if PLATFORM_OPENTITAN
	default "board" if PLATFORM_VISIONFIVE2 || PLATFORM_MILKV_MARS
	default "kernel"
	help
	  kernel: -bios none -kernel ELF (virt / sifive_* / spike / icicle /
	          opentitan — note OpenTitan rejects -bios none as a filename;
	          smoke passes -kernel only).
	  bios:   -bios ELF — machine loads firmware only (shakti / xiangshan;
	          -bios none is rejected as a filename).
	  loader: -device loader,file=ELF,cpu-num=0 (amd-microblaze-v has no
	          firmware/kernel boot path).
	  board:  no QEMU -M (VisionFive 2) — U-Boot go / OpenOCD load; see
	          PLATFORM.md. Keep out of kernel-plat-matrix until smoke exists.
	  none / host are not matrix boards (no CPU/RAM / not a QEMU -M).

config QEMU_EXTRA_ARGS
	string "Extra QEMU args (documentation / scripts)"
	default "-bios none" if PLATFORM_VIRT
	default "-bios none" if PLATFORM_SIFIVE_U
	default "-bios none" if PLATFORM_SIFIVE_E
	default "-bios none" if PLATFORM_SPIKE
	default "-bios none" if PLATFORM_MICROCHIP_ICICLE
	default ""
	help
	  Used with QEMU_LOAD_MODE=kernel (-kernel ELF appended by smoke).
	  shakti / xiangshan: leave empty; smoke passes -bios ELF.
	  amd-microblaze-v: leave empty; smoke uses -device loader.
	  microchip-icicle-kit: -bios none works for plat smoke (HSS not required).
	  OpenTitan: leave empty; smoke uses -kernel only (no -bios none).
	  VisionFive 2: leave empty — board recipe, not QEMU.

endmenu
