#
# QEMU -M machines from qemu-system-riscv64 / riscv32 -M help (QEMU 10.x).
# Aliases are not listed separately. Refresh PLATFORM.md when QEMU adds boards.
#
# Inventory (QEMU 10.1.3):
#   riscv64: virt, sifive_u, sifive_e, spike, shakti_c,
#            microchip-icicle-kit, xiangshan-kunminghu,
#            amd-microblaze-v-generic, none
#   riscv32: virt, sifive_u, sifive_e, spike, opentitan,
#            amd-microblaze-v-generic, none
#   host: not present in QEMU 10.x -M help; kept as legacy stub.
#

choice
	prompt "Target machine / board"
	default PLATFORM_VIRT

config PLATFORM_VIRT
	bool "QEMU virt (default — CI)"
	help
	  RISC-V VirtIO board. UART 16550 @ 0x10000000, CLINT, PLIC, fw_cfg,
	  ramfb, virtio-mmio/PCI. This is the supported default; all kernel-*-smoke
	  targets use -M virt.

config PLATFORM_SIFIVE_U
	bool "QEMU sifive_u (SiFive FU540 / HiFive Unleashed)"
	help
	  FU540 map: UART0 @ 0x10010000 (IRQ 4), UART1 @ 0x10011000, CLINT @
	  0x02000000 (1 MHz), PLIC @ 0x0C000000, GPIO @ 0x10060000 (reset pin 10),
	  PRCI @ 0x10000000, GEM @ 0x10090000 (RVSifiveGem). DRAM @ 0x80000000
	  (128 MiB). HolyC: RVSifivePlat + RVUartSifive + RVTimerClint + RVPlicHw.
	  No ramfb/virtio on this machine. Plat smoke exercises UART/CLINT/PLIC.

config PLATFORM_SIFIVE_E
	bool "QEMU sifive_e (SiFive FE310)"
	help
	  DTIM 16 KiB @ 0x80000000, XIP flash @ 0x20000000 (reset @ 0x20400000),
	  SiFive UART @ 0x10013000. Same RVSifivePlat API as sifive_u. Product layout:
	  Kernel in XIP/QSPI, bootloader only in DTIM. Dual artifacts: slim plat.elf
	  (matrix) and kernel-fe310.elf (see PLATFORM.md). RV32 HolyC emit later.

config PLATFORM_SPIKE
	bool "QEMU spike (HTIF + CLINT)"
	help
	  Spike bare board: HTIF console via ELF tohost/fromhost @ 0x807FF000,
	  CLINT @ 0x02000000 (10 MHz). No 16550, no PLIC, no virtio, no ramfb.
	  HolyC: RVUartHtif + RVTimerClint + RVPlicStub. Matrix plat smoke.

config PLATFORM_SHAKTI_C
	bool "QEMU shakti_c"
	help
	  Shakti C-class: DRAM @ 0x80000000, ACLINT @ 0x02000000 (10 MHz),
	  SiFive PLIC @ 0x0C000000, Shakti UART @ 0x11300 (RVUartShakti; not
	  wired to PLIC in QEMU). Load firmware only — plat smoke uses -bios
	  ELF (-bios none is rejected as a filename).

config PLATFORM_MICROCHIP_ICICLE
	bool "QEMU microchip-icicle-kit"
	help
	  PolarFire SoC Icicle Kit. Plat smoke: -bios none -kernel (HSS not
	  required for bare HolyC plat). MMUART0 @ 0x20000000 (regshift 2,
	  PLIC IRQ 90), ACLINT @ 0x02000000 (1 MHz), PLIC @ 0x0C000000.
	  min_cpus=2 (E51+U54); UART lines may interleave — smoke greps PASS.

config PLATFORM_XIANGSHAN
	bool "QEMU xiangshan-kunminghu"
	help
	  Xiangshan Kunminghu FPGA prototype. 16550 @ 0x310B0000 (regshift 2),
	  ACLINT @ 0x38000000, APLIC/IMSIC (no SiFive PLIC — RVPlicAplic). Load plat ELF as
	  -bios ( -bios none rejected).

config PLATFORM_AMD_MICROBLAZE_V
	bool "QEMU amd-microblaze-v-generic"
	help
	  AMD MicroBlaze-V generic: DDR @ 0x80000000, UARTLite (serial0) @
	  0x40600000, XPS timer @ 0x41C00000 (RVTimerXps), XPS INTC @
	  0x41200000 (RVPlicXps), 16550 serial1 @ 0x44A11000 (unused).
	  No SiFive CLINT/PLIC. Machine has no -kernel/-bios boot path —
	  plat smoke uses -device loader,file=ELF,cpu-num=0.

config PLATFORM_OPENTITAN
	bool "QEMU opentitan (riscv32 tiny profile)"
	help
	  OpenTitan Earlgrey (qemu-system-riscv32 only). Flash boot @
	  0x20000400, SRAM 128 KiB @ 0x10000000, Ibex UART @ 0x40000000
	  (RVUartIbex), Ibex timer @ 0x40100000 (RVTimerIbex), PLIC @
	  0x48000000, no CLINT. Plat smoke: RV32 asm harness until
	  ARCH_RISCV32 HolyC emit; -kernel only (-bios none rejected).

config PLATFORM_HOST
	bool "QEMU host (legacy stub — not a board)"
	help
	  Not a bare-metal board. Absent from QEMU 10.x -M help. Excluded from
	  kernel-plat-matrix (not a skip).

config PLATFORM_NONE
	bool "QEMU none (empty machine — not a board)"
	help
	  QEMU's empty machine: no CPU/RAM/devices until you add them by hand.
	  Not a TempleOS/RV board. Excluded from kernel-plat-matrix (not a skip).

config PLATFORM_VISIONFIVE2
	bool "StarFive VisionFive 2 (JH7110) — board-only"
	help
	  Real JH7110 SBC. No QEMU -M in QEMU 10.x — build + serial/OpenOCD
	  recipe only until a harness exists. UART0 DW8250 @ 0x10000000
	  (reg-shift 2; TX-to-base OK for plat), CLINT @ 0x02000000, PLIC @
	  0x0C000000, DDR @ 0x40000000 (entry 0x40200000 after OpenSBI 2 MiB).
	  FB: simplefb present hook (SIMPLEFB_* = 0 until firmware publishes XR24).
	  Keep out of kernel-plat-matrix until smoke is green (not skip=OK).

config PLATFORM_MILKV_MARS
	bool "Milk-V Mars (JH7110) — board-only"
	help
	  Milk-V Mars SBC (StarFive JH7110 — same SoC class as VisionFive 2).
	  Separate defconfig/ld/OpenOCD from visionfive2_* (do not overwrite).
	  No QEMU -M in QEMU 10.x. UART0/CLINT/PLIC/DDR map matches VF2
	  (0x10000000 / 0x02000000 / 0x0C000000 / 0x40000000, entry 0x40200000).
	  FB: simplefb present hook. Out of kernel-plat-matrix until smoke green.

config PLATFORM_CUSTOM
	bool "Custom (edit addresses below)"
	help
	  Start from virt-like defaults and override UART/CLINT/PLIC/link in menu.

endchoice

config PLATFORM_EXPERIMENTAL
	bool
	default y if PLATFORM_SIFIVE_E
	default y if PLATFORM_SHAKTI_C
	default y if PLATFORM_MICROCHIP_ICICLE
	default y if PLATFORM_XIANGSHAN
	default y if PLATFORM_AMD_MICROBLAZE_V
	default y if PLATFORM_OPENTITAN
	default y if PLATFORM_VISIONFIVE2
	default y if PLATFORM_MILKV_MARS
	default y if PLATFORM_HOST
	default y if PLATFORM_NONE
	default n

config PLATFORM_NAME
	string
	default "virt" if PLATFORM_VIRT
	default "sifive_u" if PLATFORM_SIFIVE_U
	default "sifive_e" if PLATFORM_SIFIVE_E
	default "spike" if PLATFORM_SPIKE
	default "shakti_c" if PLATFORM_SHAKTI_C
	default "microchip-icicle-kit" if PLATFORM_MICROCHIP_ICICLE
	default "xiangshan-kunminghu" if PLATFORM_XIANGSHAN
	default "amd-microblaze-v-generic" if PLATFORM_AMD_MICROBLAZE_V
	default "opentitan" if PLATFORM_OPENTITAN
	default "visionfive2" if PLATFORM_VISIONFIVE2
	default "milkv-mars" if PLATFORM_MILKV_MARS
	default "host" if PLATFORM_HOST
	default "none" if PLATFORM_NONE
	default "custom" if PLATFORM_CUSTOM
	default "virt"
