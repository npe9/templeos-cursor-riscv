# QEMU opentitan — TENTATIVE (qemu-system-riscv32 only)
# RAM 128 KiB @ 0x10000000; Ibex UART @ 0x40000000 (stub); PLIC @ 0x48000000.
# Full TempleOS/RV images do not fit — build/config only.
CONFIG_PLATFORM_OPENTITAN=y
# CONFIG_PLATFORM_VIRT is not set
CONFIG_UART_STUB=y
CONFIG_UART_BASE=0x40000000
CONFIG_HAS_PLIC=y
CONFIG_PLIC_BASE=0x48000000
CONFIG_DRAM_BASE=0x10000000
CONFIG_DRAM_SIZE=0x00020000
CONFIG_KERNEL_ENTRY=0x10000000
CONFIG_KERNEL_LINK_ADDR=0x10000000
# CONFIG_HAS_VIRTIO_MMIO is not set
# CONFIG_HAS_FW_CFG is not set
CONFIG_FB_PRESENT_NONE=y
