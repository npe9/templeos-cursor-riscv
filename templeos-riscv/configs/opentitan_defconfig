# QEMU opentitan — Earlgrey / Ibex (qemu-system-riscv32). Flash boot @ 0x20000400,
# SRAM 128 KiB @ 0x10000000, Ibex UART @ 0x40000000, Ibex timer @ 0x40100000.
# Plat smoke uses RV32 asm harness until ARCH_RISCV32 HolyC emit; HolyC drivers
# RVUartIbex + RVTimerIbex are selected for the map.
CONFIG_PLATFORM_OPENTITAN=y
# CONFIG_PLATFORM_VIRT is not set
CONFIG_UART_IBEX=y
# CONFIG_UART_STUB is not set
CONFIG_UART_BASE=0x40000000
# CONFIG_HAS_CLINT is not set
CONFIG_HAS_IBEX_TIMER=y
CONFIG_IBEX_TIMER_BASE=0x40100000
CONFIG_TIMEBASE_FREQ=10000
CONFIG_HAS_PLIC=y
CONFIG_PLIC_BASE=0x48000000
CONFIG_DRAM_BASE=0x10000000
CONFIG_DRAM_SIZE=0x00020000
CONFIG_ENTRY_POINT=0x20000400
CONFIG_KERNEL_ENTRY=0x20000400
CONFIG_KERNEL_LINK_ADDR=0x20000400
# CONFIG_HAS_VIRTIO_MMIO is not set
# CONFIG_HAS_FW_CFG is not set
CONFIG_FB_PRESENT_NONE=y
