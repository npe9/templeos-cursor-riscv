# QEMU sifive_u — SiFive UART0 + RVSifivePlat; same DRAM/CLINT/PLIC as virt; no virtio/ramfb
CONFIG_PLATFORM_SIFIVE_U=y
# CONFIG_PLATFORM_VIRT is not set
CONFIG_UART_SIFIVE=y
# CONFIG_UART_16550 is not set
# CONFIG_UART_HTIF is not set
# CONFIG_UART_STUB is not set
CONFIG_HAS_PLIC=y
# CONFIG_HAS_VIRTIO_MMIO is not set
# CONFIG_HAS_VIRTIO_PCI is not set
# CONFIG_HAS_FW_CFG is not set
# CONFIG_HAS_GOLDFISH_RTC is not set
CONFIG_FB_PRESENT_NONE=y
# CONFIG_FB_PRESENT_RAMFB is not set
# CONFIG_FB_PRESENT_SIMPLEFB is not set
