# QEMU xiangshan-kunminghu — load plat ELF as -bios ( -bios none rejected ).
# 16550 @ 0x310B0000 (regshift 2; TX-to-base OK); ACLINT @ 0x38000000;
# APLIC_M @ 0x31100000 (MSI→IMSIC; RVPlicAplic).
CONFIG_PLATFORM_XIANGSHAN=y
# CONFIG_PLATFORM_VIRT is not set
CONFIG_UART_16550=y
CONFIG_UART_BASE=0x310B0000
CONFIG_UART_REG_SHIFT=2
CONFIG_CLINT_BASE=0x38000000
# CONFIG_HAS_PLIC is not set
CONFIG_HAS_APLIC=y
CONFIG_APLIC_BASE=0x31100000
CONFIG_IMSIC_BASE=0x3A800000
# CONFIG_HAS_VIRTIO_MMIO is not set
# CONFIG_HAS_FW_CFG is not set
CONFIG_FB_PRESENT_NONE=y
CONFIG_TIMEBASE_FREQ=1000000
