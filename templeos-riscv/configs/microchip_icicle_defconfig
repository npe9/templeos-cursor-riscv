# QEMU microchip-icicle-kit — TENTATIVE (needs hss.bin)
# MMUART0 @ 0x20000000 (16550-ish best-guess); CLINT @ 0x02000000; PLIC @ 0x0C000000.
# Bare -bios none typically fails without HSS firmware.
CONFIG_PLATFORM_MICROCHIP_ICICLE=y
# CONFIG_PLATFORM_VIRT is not set
CONFIG_UART_16550=y
CONFIG_UART_BASE=0x20000000
CONFIG_HAS_PLIC=y
CONFIG_PLIC_BASE=0x0C000000
CONFIG_CLINT_BASE=0x02000000
# CONFIG_HAS_VIRTIO_MMIO is not set
# CONFIG_HAS_FW_CFG is not set
CONFIG_FB_PRESENT_NONE=y
