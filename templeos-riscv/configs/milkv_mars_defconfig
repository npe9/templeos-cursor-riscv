# Milk-V Mars (StarFive JH7110) — real board; no QEMU -M in QEMU 10.x.
# Same JH7110 map as VisionFive 2 (separate defconfig — do not overwrite
# visionfive2_*). UART0 DW8250 @ 0x10000000 (reg-shift 2), CLINT @
# 0x02000000, PLIC @ 0x0C000000, DDR @ 0x40000000, link/entry @ 0x40200000
# (after OpenSBI 2 MiB reserved). TIMEBASE 4 MHz. FB: simplefb present hook;
# SIMPLEFB_BASE=0 until firmware publishes XR24 (RVFbSimpleFbBind). Keep out
# of plat matrix until a smoke exists (not skip=OK).
# Build: make kernel-milkv-mars | make kernel-milkv-mars-help
CONFIG_PLATFORM_MILKV_MARS=y
# CONFIG_PLATFORM_VIRT is not set
CONFIG_UART_16550=y
CONFIG_UART_BASE=0x10000000
CONFIG_UART_IRQ=32
CONFIG_UART_REG_SHIFT=2
CONFIG_HAS_CLINT=y
CONFIG_CLINT_BASE=0x02000000
CONFIG_HAS_PLIC=y
CONFIG_PLIC_BASE=0x0C000000
CONFIG_TIMEBASE_FREQ=4000000
CONFIG_DRAM_BASE=0x40000000
CONFIG_DRAM_SIZE=0x80000000
CONFIG_ENTRY_POINT=0x40200000
CONFIG_KERNEL_ENTRY=0x40200000
CONFIG_KERNEL_LINK_ADDR=0x40200000
CONFIG_GUEST_BLOB_ADDR=0x40300000
CONFIG_COMPILER_SLOT_ADDR=0x40400000
CONFIG_TOS_API_ADDR=0x40500000
CONFIG_HEAP_BASE=0x46000000
CONFIG_FB_SOFT_BASE=0x46100000
CONFIG_SYS_FIXED_AREA=0x47000000
CONFIG_HOST_SLOTS_BASE=0x47001000
CONFIG_SMP_MAILBOX_BASE=0x47001E00
CONFIG_MEMFS_BASE=0x47800000
CONFIG_STACK_BASE=0x47F00000
# CONFIG_HAS_VIRTIO_MMIO is not set
# CONFIG_HAS_FW_CFG is not set
# CONFIG_HAS_GOLDFISH_RTC is not set
CONFIG_FB_PRESENT_SIMPLEFB=y
# CONFIG_FB_PRESENT_RAMFB is not set
# CONFIG_FB_PRESENT_NONE is not set
CONFIG_SIMPLEFB_BASE=0x0
CONFIG_SIMPLEFB_WIDTH=0
CONFIG_SIMPLEFB_HEIGHT=0
CONFIG_SIMPLEFB_STRIDE=0
CONFIG_QEMU_LOAD_MODE="board"
CONFIG_QEMU_MACHINE="board-only"
CONFIG_QEMU_EXTRA_ARGS=""
