# QEMU shakti_c — TENTATIVE
# DRAM @ 0x80000000; CLINT/PLIC virt-like; Shakti UART @ 0x11300 (stub — no HolyC driver).
CONFIG_PLATFORM_SHAKTI_C=y
# CONFIG_PLATFORM_VIRT is not set
CONFIG_UART_STUB=y
CONFIG_UART_BASE=0x00011300
CONFIG_HAS_PLIC=y
CONFIG_PLIC_BASE=0x0C000000
CONFIG_CLINT_BASE=0x02000000
# CONFIG_HAS_VIRTIO_MMIO is not set
# CONFIG_HAS_FW_CFG is not set
CONFIG_FB_PRESENT_NONE=y
